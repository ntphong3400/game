class GameApp extends StatelessWidget {
  const GameApp({
    super.key,
    required this.controller,
    this.initialRoute = 'citadel',
    this.outcomeReadStore,
  });
  final GameController controller;
  final OutcomeReadStore? outcomeReadStore;

  /// Starting section; existing section tests can open their subject directly.
  final String initialRoute;
  @override
  Widget build(BuildContext context) => MaterialApp(
    title: 'Vạn Tuế — Một đời đế vương',
    debugShowCheckedModeBanner: false,
    theme: ThemeData(
      useMaterial3: true,
      fontFamily: 'BeVietnam',
      scaffoldBackgroundColor: parchment,
      colorScheme: ColorScheme.fromSeed(
        seedColor: forest,
        primary: forest,
        surface: paper,
        onSurface: ink,
      ),
      textTheme: const TextTheme(
        bodyMedium: TextStyle(fontSize: 13, height: 1.65, color: ink),
        bodySmall: TextStyle(fontSize: 11, height: 1.65, color: muted),
      ),
      dividerColor: line,
      filledButtonTheme: FilledButtonThemeData(
        style: FilledButton.styleFrom(
          backgroundColor: forest,
          foregroundColor: paper,
          minimumSize: const Size(0, 46),
          padding: const EdgeInsets.symmetric(horizontal: 22, vertical: 15),
          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
        ),
      ),
      outlinedButtonTheme: OutlinedButtonThemeData(
        style: OutlinedButton.styleFrom(
          foregroundColor: forest,
          side: const BorderSide(color: line),
          minimumSize: const Size(0, 44),
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
        ),
      ),
      inputDecorationTheme: InputDecorationTheme(
        filled: true,
        fillColor: paper,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(8),
          borderSide: const BorderSide(color: line),
        ),
        enabledBorder: OutlineInputBorder(
          borderRadius: BorderRadius.circular(8),
          borderSide: const BorderSide(color: line),
        ),
      ),
      snackBarTheme: SnackBarThemeData(
        behavior: SnackBarBehavior.floating,
        backgroundColor: ink,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
      ),
      dialogTheme: DialogTheme(
        backgroundColor: paper,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      ),
    ),
    home: GameShell(
      controller: controller,
      initialRoute: initialRoute,
      outcomeReadStore: outcomeReadStore,
    ),
  );
}

class GameShell extends StatefulWidget {
  const GameShell({
    super.key,
    required this.controller,
    this.initialRoute = 'citadel',
    this.outcomeReadStore,
  });
  final GameController controller;
  final OutcomeReadStore? outcomeReadStore;
  final String initialRoute;
  @override
  State<GameShell> createState() => _GameShellState();
}

class _GameShellState extends State<GameShell> {
  late String route = widget.initialRoute;
  final scaffoldKey = GlobalKey<ScaffoldState>();
  GameController get controller => widget.controller;
  GameState get s => controller.state!;
  bool get busy => controller.busy;
  final scrollController = ScrollController();
  final courtReadingController = ScrollController();
  final courtSearch = TextEditingController();
  final haremSearch = TextEditingController();
  String courtCategory = 'Tất cả', haremCategory = 'Tất cả';
  String courtFaction = 'Tất cả', haremFaction = 'Tất cả';
  String scoreRules = rulesVersion;
  String? acknowledgedEnding;
  String? selectedPetitionId, approvedPetitionTitle;
  bool petitionDialogOpen = false;
  bool personDialogOpen = false;
  bool palaceManagementOpen = false;
  String? selectedOfficialId, selectedConsortId;
  String courtAvailability = 'Tất cả', haremAvailability = 'Tất cả';
  bool courtListView = false, haremListView = false;
  String? selectedCareId;
  int selectedChronicleIndex = 0;
  late final _outcomeReadStore = widget.outcomeReadStore ?? OutcomeReadStore();
  String? _outcomeReadRun;
  bool _outcomeReadReady = false;
  final _readOutcomeIds = <String>{};
  final taxSectionKey = GlobalKey(),
      revenueSectionKey = GlobalKey(),
      stockSectionKey = GlobalKey();
  static const navigation = <(String, IconData, String)>[
    ('citadel', Icons.castle_outlined, 'Hoàng thành'),
    ('court', Icons.account_balance_outlined, 'Triều chính'),
    ('kingdom', Icons.landscape_outlined, 'Quốc sự'),
    ('treasury', Icons.toll_outlined, 'Ngân khố'),
    ('people', Icons.groups_outlined, 'Triều thần'),
    ('harem', Icons.local_florist_outlined, 'Hậu cung'),
    ('health', Icons.favorite_border, 'Long thể'),
    ('journal', Icons.menu_book_outlined, 'Sử ký'),
    ('scores', Icons.emoji_events_outlined, 'Bảng xếp hạng'),
  ];

  @override
  void initState() {
    super.initState();
    controller.addListener(_loadOutcomeReadState);
    _loadOutcomeReadState();
  }

  @override
  void didUpdateWidget(covariant GameShell oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.controller != controller) {
      oldWidget.controller.removeListener(_loadOutcomeReadState);
      controller.addListener(_loadOutcomeReadState);
      _outcomeReadRun = null;
      _loadOutcomeReadState();
    }
  }

  void _loadOutcomeReadState() {
    final run = controller.state?.runId;
    if (run == _outcomeReadRun) return;
    _outcomeReadRun = run;
    _outcomeReadReady = false;
    _readOutcomeIds.clear();
    if (run == null) return;
    _outcomeReadStore.read(run).then((ids) {
      if (!mounted || _outcomeReadRun != run) return;
      setState(() {
        _readOutcomeIds.addAll(ids);
        _outcomeReadReady = true;
      });
    });
  }

  Future<void> _viewOutcomeReports(List<OutcomeReport> reports) async {
    final run = s.runId;
    await showOutcomeReports(context, reports, seasonal: s.seasonal);
    if (!mounted || controller.state?.runId != run) return;
    final ids = reports.map((r) => r.id).toSet();
    setState(() => _readOutcomeIds.addAll(ids));
    await _outcomeReadStore.markRead(run, ids);
  }

  @override
  void dispose() {
    controller.removeListener(_loadOutcomeReadState);
    scrollController.dispose();
    courtReadingController.dispose();
    courtSearch.dispose();
    haremSearch.dispose();
    super.dispose();
  }

  void navigate(String value) {
    setState(() {
      route = value;
      palaceManagementOpen = false;
    });
    if (scrollController.hasClients) scrollController.jumpTo(0);
  }

  Future<bool> act(
    String type, {
    String target = '',
    String option = '',
    String assigneeId = '',
  }) async {
    final previousOutcomes = controller.state?.outcomes.length ?? 0;
    final ok = await controller.act(
      type,
      target: target,
      option: option,
      assigneeId: assigneeId,
    );
    if (!mounted) return ok;
    final messenger = ScaffoldMessenger.of(context);
    messenger.hideCurrentSnackBar();
    if (!ok) {
      messenger.showSnackBar(
        SnackBar(
          content: Text(
            s.calendarText(controller.error ?? 'Chưa thực hiện được.'),
          ),
        ),
      );
    } else if (type != 'endWeek' && !s.ended) {
      messenger.showSnackBar(
        SnackBar(
          duration: const Duration(seconds: 2),
          content: Row(
            children: [
              Icon(Icons.check_circle_outline, color: Colors.white, size: 18),
              const SizedBox(width: 10),
              Expanded(child: Text(s.journal.first.title)),
            ],
          ),
        ),
      );
    }
    if (ok && s.outcomes.length > previousOutcomes) {
      await _viewOutcomeReports(s.outcomes.skip(previousOutcomes).toList());
    }
    return ok;
  }

  Future<void> startDialog() async {
    final name = TextEditingController(
      text: controller.state?.playerName ?? '',
    );
    final form = GlobalKey<FormState>();
    final result = await showDialog<String>(
      context: context,
      builder:
          (context) => ImperialAlertDialog(
            title: const Text(
              'Một triều đại mới',
              style: TextStyle(fontFamily: 'Lora'),
            ),
            content: SizedBox(
              width: 380,
              child: Form(
                key: form,
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text(
                      'Mười tám tuổi, bạn nhận ngọc tỷ. Từ hôm nay, vận mệnh giang sơn nằm trong từng quyết định.',
                    ),
                    const SizedBox(height: 22),
                    TextFormField(
                      controller: name,
                      autofocus: true,
                      maxLength: 32,
                      decoration: const InputDecoration(
                        labelText: 'Tên người chơi',
                        hintText: 'Bạn muốn được ghi tên thế nào?',
                      ),
                      validator:
                          (value) =>
                              value == null || value.trim().isEmpty
                                  ? 'Vui lòng nhập tên người chơi.'
                                  : null,
                      onFieldSubmitted: (_) {
                        if (form.currentState!.validate()) {
                          Navigator.pop(context, name.text.trim());
                        }
                      },
                    ),
                    if (controller.state != null && !s.ended)
                      const Text(
                        'Bắt đầu lại sẽ thay lượt đang chơi. Lượt bị bỏ không được ghi thành tích.',
                        style: TextStyle(color: terracotta, fontSize: 12),
                      ),
                  ],
                ),
              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(context),
                child: const Text('Để sau'),
              ),
              FilledButton(
                onPressed: () {
                  if (form.currentState!.validate()) {
                    Navigator.pop(context, name.text.trim());
                  }
                },
                child: const Text('Nhận ngọc tỷ'),
              ),
            ],
          ),
    );
    // A dialog can still be unmounting during its reverse animation.
    Future<void>.delayed(const Duration(milliseconds: 500), name.dispose);
    if (result == null || !mounted) return;
    final ok = await controller.start(result);
    if (!mounted) return;
    if (ok) {
      navigate('citadel');
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(controller.error ?? 'Không thể bắt đầu lượt mới.'),
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) => AnimatedBuilder(
    animation: controller,
    builder: (context, _) {
      if (controller.loading) {
        return const Scaffold(
          body: Center(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Crest(size: 56),
                SizedBox(height: 24),
                CircularProgressIndicator(strokeWidth: 2),
              ],
            ),
          ),
        );
      }
      if (route == 'home' || (controller.state == null && route != 'scores')) {
        return _landing();
      }
      if (controller.state?.ended == true && route != 'scores') {
        return acknowledgedEnding == s.runId ? _ending() : _endingReason();
      }
      if (route == 'citadel') {
        return Scaffold(
          key: scaffoldKey,
          backgroundColor: const Color(0xFF142D28),
          drawer: Drawer(backgroundColor: paper, child: _sidebar()),
          body: CitadelHub(
            state: s,
            busy: busy,
            onNavigate: navigate,
            onMenu: () => scaffoldKey.currentState?.openDrawer(),
            onEndTurn: _nextWeek,
            onOvertime: _overtimeDialog,
          ),
        );
      }
      if ([
        'court',
        'treasury',
        'people',
        'harem',
        'health',
        'kingdom',
        'journal',
        'scores',
      ].contains(route)) {
        return _roomShell();
      }
      return LayoutBuilder(
        builder: (context, constraints) {
          final desktop = constraints.maxWidth >= 1050;
          return Scaffold(
            key: scaffoldKey,
            drawer:
                desktop
                    ? null
                    : Drawer(backgroundColor: paper, child: _sidebar()),
            body: Row(
              children: [
                if (desktop) SizedBox(width: 184, child: _sidebar()),
                Expanded(
                  child: Column(
                    children: [
                      _toolbar(desktop),
                      if (busy) const LinearProgressIndicator(minHeight: 2),
                      Expanded(
                        child: SingleChildScrollView(
                          controller: scrollController,
                          padding: EdgeInsets.all(desktop ? 24 : 16),
                          child: Center(
                            child: ConstrainedBox(
                              constraints: const BoxConstraints(maxWidth: 1320),
                              child: _page(),
                            ),
                          ),
                        ),
                      ),
                      if (controller.state != null &&
                          !s.ended &&
                          route != 'scores')
                        _weekbar(desktop),
                    ],
                  ),
                ),
              ],
            ),
          );
        },
      );
    },
  );

  Widget _roomShell() => ImperialRoomScope(
    child: Theme(
      data: roomTheme(context),
      child: Builder(
        builder:
            (context) => LayoutBuilder(
              builder: (context, bounds) {
                final desktop = bounds.maxWidth >= 1050;
                final title = switch (route) {
                  'court' => 'Giang sơn trong tay người',
                  'treasury' => 'Ngân khố',
                  'people' => 'Những người bên ngai vàng',
                  'kingdom' => 'Điện nghị sự',
                  'journal' => 'Sử quán',
                  'scores' => 'Điện lưu danh',
                  'harem' =>
                    palaceManagementOpen ? 'Học tập & cung vụ' : 'Sau rèm châu',
                  _ => 'Long thể & nhịp sống',
                };
                return Scaffold(
                  key: scaffoldKey,
                  backgroundColor: imperialDeep,
                  drawer:
                      desktop
                          ? null
                          : Drawer(
                            backgroundColor: imperialDeep,
                            child: _sidebar(),
                          ),
                  body: SafeArea(
                    child: Column(
                      children: [
                        if (controller.state == null)
                          _archiveHud(desktop)
                        else
                          RoomHud(
                            state: s,
                            desktop: desktop,
                            onMenu:
                                () => scaffoldKey.currentState?.openDrawer(),
                            onHome: () => navigate('citadel'),
                            onNavigate: navigate,
                          ),
                        if (busy)
                          const LinearProgressIndicator(
                            minHeight: 2,
                            color: imperialGold,
                            backgroundColor: imperialDeep,
                          ),
                        Expanded(
                          child: Row(
                            children: [
                              if (desktop)
                                RoomRail(
                                  entries: navigation,
                                  active: route,
                                  onNavigate: navigate,
                                ),
                              Expanded(
                                child: RoomStage(
                                  scene: route,
                                  title: title,
                                  focusContent: route == 'court',
                                  scenery:
                                      route == 'treasury'
                                          ? _treasuryScenery()
                                          : null,
                                  controller: scrollController,
                                  child: _page(),
                                ),
                              ),
                            ],
                          ),
                        ),
                        if (controller.state != null &&
                            !s.ended &&
                            route != 'scores')
                          _weekbar(desktop),
                      ],
                    ),
                  ),
                );
              },
            ),
      ),
    ),
  );

  Widget _archiveHud(bool desktop) => Container(
    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
    decoration: const BoxDecoration(
      color: imperialDeep,
      border: Border(bottom: BorderSide(color: imperialGold)),
    ),
    child: Row(
      children: [
        if (!desktop)
          IconButton(
            tooltip: 'Mở danh mục',
            onPressed: () => scaffoldKey.currentState?.openDrawer(),
            icon: const Icon(Icons.menu, color: imperialGold),
          ),
        IconButton(
          tooltip: 'Về trang chính',
          onPressed: () => navigate('home'),
          icon: const Icon(Icons.castle_outlined, color: imperialGold),
        ),
        const Expanded(
          child: Text(
            'VẠN TUẾ · ĐIỆN LƯU DANH',
            style: TextStyle(
              fontFamily: 'Lora',
              fontSize: 18,
              color: imperialIvory,
            ),
          ),
        ),
      ],
    ),
  );

  Future<void> _reveal(GlobalKey target) async {
    final targetContext = target.currentContext;
    if (targetContext != null) {
      await Scrollable.ensureVisible(
        targetContext,
        duration: const Duration(milliseconds: 220),
        alignment: .05,
      );
    }
  }

  Widget _treasuryScenery() => LayoutBuilder(
    builder:
        (context, bounds) => Row(
          mainAxisAlignment: MainAxisAlignment.spaceEvenly,
          crossAxisAlignment: CrossAxisAlignment.end,
          children: [
            for (final item in <(String, int, int, bool)>[
              ('Ngân khố', s.treasury, 0, false),
              ('Kho lương', s.grain, 1, false),
              ('Nợ chi trả', s.debt, 2, s.debt > 0),
            ])
              Flexible(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    TreasuryObject(
                      index: item.$3,
                      width: bounds.maxWidth < 500 ? 90 : 190,
                      height: (bounds.maxHeight - 115).clamp(42.0, 160.0),
                    ),
                    RoomPlaque(
                      label: item.$1,
                      value: '${item.$2}',
                      warning: item.$4,
                    ),
                  ],
                ),
              ),
          ],
        ),
  );

  Widget _sidebar() => Container(
    decoration: const BoxDecoration(
      color: imperialDeep,
      border: Border(right: BorderSide(color: line)),
    ),
    child: SafeArea(
      child: SingleChildScrollView(
        child: Padding(
          padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 28),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              InkWell(
                onTap: () => navigate('home'),
                borderRadius: BorderRadius.circular(8),
                child: const Padding(
                  padding: EdgeInsets.symmetric(horizontal: 10),
                  child: Row(
                    children: [
                      Crest(size: 38),
                      SizedBox(width: 12),
                      Expanded(
                        child: FittedBox(
                          alignment: Alignment.centerLeft,
                          fit: BoxFit.scaleDown,
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                'VẠN TUẾ',
                                style: TextStyle(
                                  fontFamily: 'Lora',
                                  fontSize: 19,
                                  color: imperialIvory,
                                  letterSpacing: 2,
                                ),
                              ),
                              Text(
                                'MỘT ĐỜI ĐẾ VƯƠNG',
                                style: TextStyle(
                                  fontSize: 7,
                                  color: imperialGold,
                                  letterSpacing: 1.6,
                                ),
                              ),
                            ],
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
              const SizedBox(height: 44),
              const Padding(
                padding: EdgeInsets.only(left: 13, bottom: 14),
                child: Text(
                  'CHỐN HOÀNG THÀNH',
                  style: TextStyle(
                    fontSize: 9,
                    color: imperialGold,
                    letterSpacing: 1.6,
                  ),
                ),
              ),
              ...navigation.map((item) {
                final selected = route == item.$1;
                return Padding(
                  padding: const EdgeInsets.only(bottom: 5),
                  child: Material(
                    color: selected ? imperialJade : Colors.transparent,
                    borderRadius: BorderRadius.circular(8),
                    child: InkWell(
                      key: ValueKey('nav-${item.$1}'),
                      borderRadius: BorderRadius.circular(8),
                      onTap: () {
                        if (scaffoldKey.currentState?.isDrawerOpen == true) {
                          Navigator.pop(context);
                        }
                        navigate(item.$1);
                      },
                      child: Padding(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 13,
                          vertical: 14,
                        ),
                        child: Row(
                          children: [
                            ImperialIcon(item.$1, size: 34),
                            const SizedBox(width: 12),
                            Expanded(
                              child: Text(
                                item.$3,
                                style: TextStyle(
