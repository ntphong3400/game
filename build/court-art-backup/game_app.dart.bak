                                      selected
                                          ? FontWeight.w600
                                          : FontWeight.normal,
                                  color:
                                      selected ? imperialIvory : imperialGold,
                                ),
                              ),
                            ),
                            if (item.$1 == 'court' &&
                                controller.state != null &&
                                s.petitions.isNotEmpty)
                              Badge.count(
                                count: s.petitions.length,
                                backgroundColor: gold,
                                textColor: paper,
                              ),
                          ],
                        ),
                      ),
                    ),
                  ),
                );
              }),
              const SizedBox(height: 24),
              Container(
                padding: const EdgeInsets.all(14),
                decoration: BoxDecoration(
                  color: imperialJade,
                  borderRadius: BorderRadius.circular(10),
                ),
                child: const Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Icon(Icons.spa_outlined, color: imperialGold, size: 22),
                    SizedBox(height: 10),
                    Text(
                      'Giữ nước, giữ lòng người.\nVà giữ cả chính mình.',
                      style: TextStyle(
                        fontFamily: 'Lora',
                        color: imperialIvory,
                        fontSize: 12,
                        height: 1.7,
                      ),
