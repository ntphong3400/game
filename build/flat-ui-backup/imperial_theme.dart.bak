import 'package:flutter/material.dart';

const parchment = Color(0xFFF2E9D8);
const paper = Color(0xFFFFF9ED);
const ink = Color(0xFF352F25);
const muted = Color(0xFF786D58);
const forest = Color(0xFF214B3D);
const gold = Color(0xFFA77F40);
const line = Color(0xFFE0CFAD);
const terracotta = Color(0xFFA23E32);

class Surface extends StatelessWidget {
  const Surface({
    super.key,
    required this.child,
    this.padding = 22,
    this.selected = false,
  });
  final Widget child;
  final double padding;
  final bool selected;

  @override
  Widget build(BuildContext context) => Container(
    width: double.infinity,
    padding: EdgeInsets.all(padding),
    decoration: BoxDecoration(
      color: paper,
      border: Border.all(
        color: selected ? gold : line,
        width: selected ? 1.5 : 1,
      ),
      borderRadius: BorderRadius.circular(7),
      boxShadow: const [
        BoxShadow(
          color: Color(0x08000000),
          blurRadius: 12,
          offset: Offset(0, 4),
        ),
      ],
    ),
    child: child,
  );
}

class Tag extends StatelessWidget {
  const Tag(this.text, {super.key, this.color = gold});
  final String text;
  final Color color;

  @override
  Widget build(BuildContext context) => Container(
    padding: const EdgeInsets.symmetric(horizontal: 9, vertical: 6),
    decoration: BoxDecoration(
      color: color.withValues(alpha: .09),
      borderRadius: BorderRadius.circular(3),
    ),
    child: Text(
      text,
      style: TextStyle(
        fontSize: 9,
        letterSpacing: .7,
        color: color,
        fontWeight: FontWeight.w600,
      ),
    ),
  );
}
