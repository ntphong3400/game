import 'dart:math' as math;
import 'package:flutter/material.dart';
import '../../models/game_state.dart';

const imperialJade = Color(0xFF16372F);
const imperialDeep = Color(0xFF102922);
const imperialGold = Color(0xFFD9B873);
const imperialIvory = Color(0xFFFFF1CE);

class PalaceSceneHeader extends StatelessWidget {
  const PalaceSceneHeader({
    super.key,
    required this.scene,
    required this.title,
    required this.subtitle,
    required this.eyebrow,
    this.trailing,
  });
  final String scene, title, subtitle, eyebrow;
  final Widget? trailing;

  @override
  Widget build(BuildContext context) => Container(
    key: ValueKey('scene-header-$scene'),
    width: double.infinity,
    margin: const EdgeInsets.only(bottom: 22),
    clipBehavior: Clip.antiAlias,
    decoration: BoxDecoration(
      borderRadius: BorderRadius.circular(10),
      border: Border.all(color: const Color(0xFFAC8549)),
      color: imperialJade,
    ),
    child: Stack(
      children: [
        Positioned.fill(
          child: Image.asset(
            'assets/images/$scene-interior.webp',
            fit: BoxFit.cover,
            alignment: const Alignment(.3, -.1),
            excludeFromSemantics: true,
          ),
        ),
        const Positioned.fill(
          child: DecoratedBox(
            decoration: BoxDecoration(
              gradient: LinearGradient(
                colors: [
                  Color(0xF0102922),
                  Color(0xB0102922),
                  Color(0x10102922),
                ],
                stops: [0, .45, 1],
              ),
            ),
          ),
        ),
        Padding(
          padding: const EdgeInsets.all(26),
          child: LayoutBuilder(
            builder:
                (context, bounds) => Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      eyebrow.toUpperCase(),
                      style: const TextStyle(
                        color: imperialGold,
                        fontSize: 10,
                        letterSpacing: 2,
                      ),
                    ),
                    const SizedBox(height: 14),
                    Text(
                      title,
                      style: TextStyle(
                        color: imperialIvory,
                        fontFamily: 'Lora',
                        fontSize: bounds.maxWidth < 500 ? 26 : 34,
                        height: 1.25,
                      ),
                    ),
                    const SizedBox(height: 12),
                    ConstrainedBox(
                      constraints: const BoxConstraints(maxWidth: 520),
                      child: Text(
                        subtitle,
                        style: const TextStyle(
                          color: imperialIvory,
                          fontSize: 12,
                          height: 1.8,
                        ),
                      ),
                    ),
                    if (trailing != null) ...[
                      const SizedBox(height: 16),
                      trailing!,
                    ],
                  ],
                ),
          ),
        ),
      ],
    ),
  );
}

/// One shared HUD for all five interior screens. Reading it never dispatches commands.
class ImperialStatusBar extends StatelessWidget {
  const ImperialStatusBar({
    super.key,
    required this.state,
    required this.title,
    required this.onMenu,
    required this.onHome,
    required this.onNavigate,
    required this.desktop,
  });
  final GameState state;
  final String title;
  final VoidCallback onMenu, onHome;
  final ValueChanged<String> onNavigate;
  final bool desktop;

  @override
  Widget build(BuildContext context) => Container(
    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 9),
    decoration: const BoxDecoration(
      color: imperialDeep,
      border: Border(bottom: BorderSide(color: imperialGold)),
    ),
    child: LayoutBuilder(
      builder: (context, bounds) {
        final roomy = bounds.maxWidth >= 740;
        final identity = Row(
          children: [
            IconButton(
              tooltip: desktop ? 'Về Hoàng thành' : 'Mở danh mục',
              onPressed: desktop ? onHome : onMenu,
              icon: Icon(
                desktop ? Icons.castle_outlined : Icons.menu,
                color: imperialGold,
                size: 22,
              ),
            ),
            if (!desktop)
              IconButton(
                tooltip: 'Về Hoàng thành',
                onPressed: onHome,
                icon: const Icon(
                  Icons.castle_outlined,
                  color: imperialGold,
                  size: 22,
                ),
              ),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisSize: MainAxisSize.min,
                children: [
                  Text(
                    title,
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(
                      fontFamily: 'Lora',
                      fontSize: 18,
                      color: imperialIvory,
                    ),
                  ),
                  Text(
                    '${state.playerName} · ${state.seasonal ? 'Mùa ${state.season}' : 'Tuần ${state.week}'} · năm ${state.year}',
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(fontSize: 10, color: imperialGold),
                  ),
                ],
              ),
            ),
          ],
        );
        final stats = <(String, int, IconData, String)>[
          ('Ngân khố', state.treasury, Icons.savings_outlined, 'treasury'),
          ('Lòng dân', state.people, Icons.groups_outlined, 'court'),
          (
            'Uy quyền',
            state.authority,
            Icons.workspace_premium_outlined,
            'court',
          ),
          ('Quân lực', state.army, Icons.shield_outlined, 'kingdom'),
          ('Sức khỏe', state.health, Icons.favorite_border, 'health'),
          (
            'Ổn định triều đình',
            state.stability,
            Icons.balance_outlined,
            'court',
          ),
        ];
        final values = LayoutBuilder(
          builder:
              (context, box) => Row(
                children: [
                  for (final stat in stats)
                    Expanded(
                      child: Tooltip(
                        message:
                            '${stat.$1}: ${stat.$2}${stat.$4 == 'treasury' ? ' tiền' : '/100'}',
                        child: InkWell(
                          onTap: () => onNavigate(stat.$4),
                          borderRadius: BorderRadius.circular(5),
                          child: Padding(
                            padding: const EdgeInsets.symmetric(
                              vertical: 5,
                              horizontal: 2,
                            ),
                            child: Column(
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                Icon(
                                  stat.$3,
                                  color: imperialGold,
                                  size: roomy ? 18 : 16,
                                ),
                                Text(
                                  '${stat.$2}',
                                  style: TextStyle(
                                    fontFamily: 'Lora',
                                    fontSize: roomy ? 17 : 15,
                                    color:
                                        stat.$4 != 'treasury' && stat.$2 <= 20
                                            ? const Color(0xFFFFAA90)
                                            : imperialIvory,
                                  ),
                                ),
                                Text(
                                  stat.$1,
                                  maxLines: roomy ? 1 : 2,
                                  textAlign: TextAlign.center,
                                  style: const TextStyle(
                                    fontSize: 9,
                                    color: imperialIvory,
                                  ),
                                ),
                              ],
                            ),
                          ),
                        ),
                      ),
                    ),
                ],
              ),
        );
        return roomy
            ? Row(
              children: [
                SizedBox(width: 240, child: identity),
                Expanded(child: values),
              ],
            )
            : Column(children: [identity, const SizedBox(height: 4), values]);
      },
    ),
  );
}

/// Runtime atlas sampling keeps portraits aligned without separate cropped files.
class CharacterPortrait extends StatelessWidget {
  const CharacterPortrait({
    super.key,
    this.person,
    this.emperor = false,
    this.width = 88,
    this.height = 108,
  });
  final Courtier? person;
  final bool emperor;
  final double width, height;

  int get portraitIndex {
    if (emperor) return 0;
    final c = person!;
    final hash = c.id.codeUnits.fold(0, (a, b) => (a * 31 + b) & 0x7fffffff);
    if (c.isConsort) return 8 + hash % 8;
    if (c.role == 'Ngự y') return 6;
    if (c.category == 'Võ ban') return 2;
    return 1 + hash % 7;
  }

  @override
  Widget build(BuildContext context) {
    final index = portraitIndex;
    return Semantics(
      image: true,
      label:
          emperor
              ? 'Chân dung minh họa hoàng đế'
              : 'Chân dung minh họa ${person!.name}',
      child: Container(
        width: width,
        height: height,
        clipBehavior: Clip.antiAlias,
        decoration: BoxDecoration(
          color: const Color(0xFFE7D8BA),
          borderRadius: BorderRadius.circular(6),
          border: Border.all(color: const Color(0xFFB89559)),
        ),
        child: LayoutBuilder(
          builder: (context, bounds) {
            final side = math.max(bounds.maxWidth, bounds.maxHeight);
            return Stack(
              clipBehavior: Clip.hardEdge,
              children: [
                Positioned(
                  left: bounds.maxWidth / 2 - (index % 4 + .5) * side,
                  top: bounds.maxHeight / 2 - (index ~/ 4 + .5) * side,
                  width: side * 4,
                  height: side * 4,
                  child: Image.asset(
                    'assets/images/character-portraits.webp',
                    fit: BoxFit.fill,
                    excludeFromSemantics: true,
                    errorBuilder:
                        (_, _, _) => const ColoredBox(color: Color(0xFFE7D8BA)),
                  ),
                ),
              ],
            );
          },
        ),
      ),
    );
  }
}

class ImperialResource extends StatelessWidget {
  const ImperialResource({
    super.key,
    required this.label,
    required this.value,
    required this.detail,
    required this.icon,
    this.warning = false,
  });
  final String label, value, detail;
  final IconData icon;
  final bool warning;

  @override
  Widget build(BuildContext context) => Container(
    padding: const EdgeInsets.all(20),
    decoration: BoxDecoration(
      color: const Color(0xFFFFF8E8),
      border: Border.all(color: const Color(0xFFD7BF91)),
      borderRadius: BorderRadius.circular(8),
    ),
    child: Row(
      children: [
        Container(
          padding: const EdgeInsets.all(12),
          decoration: const BoxDecoration(
            color: Color(0xFFF0E2C4),
            shape: BoxShape.circle,
          ),
          child: Icon(icon, size: 27, color: const Color(0xFF9F783B)),
        ),
        const SizedBox(width: 16),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                label,
                style: const TextStyle(fontSize: 12, color: Color(0xFF796747)),
              ),
              Text(
                value,
                style: TextStyle(
                  fontFamily: 'Lora',
                  fontSize: 30,
                  color: warning ? const Color(0xFF9B362E) : imperialJade,
                ),
              ),
              Text(
                detail,
                style: const TextStyle(fontSize: 11, color: Color(0xFF796747)),
              ),
            ],
          ),
        ),
      ],
    ),
  );
}

class ImperialSplit extends StatelessWidget {
  const ImperialSplit({
    super.key,
    required this.main,
    required this.aside,
    this.breakpoint = 900,
    this.asideWidth = 300,
  });
  final Widget main, aside;
  final double breakpoint, asideWidth;

  @override
  Widget build(BuildContext context) => LayoutBuilder(
    builder:
        (context, bounds) =>
            bounds.maxWidth < breakpoint
                ? Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [main, const SizedBox(height: 22), aside],
                )
                : Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Expanded(child: main),
                    const SizedBox(width: 22),
                    SizedBox(width: asideWidth, child: aside),
                  ],
                ),
  );
}
