            .where((a) => ['rest', 'revel', 'treat'].contains(a.id))
            .toList(),
      ),
      const SizedBox(height: 24),
      Surface(
        child: Text(
          'Dưỡng sức giúp giảm mệt mỏi; thưởng nhạc, yến tiệc giúp giảm căng thẳng. Hiệu quả áp dụng khi khép ${s.periodName}, cộng với hồi phục tự nhiên và tác hại từ công việc, chiến tranh. Tiệc tùng liên tục hoặc hưởng lạc tích lũy gây hại sức khỏe; một ${s.periodName} nghỉ không xóa hết tác hại kéo dài.',
          style: TextStyle(color: muted, height: 1.9),
        ),
      ),
    ],
  );

  Widget _smallMeter(
    String label,
    int value, {
    int maximum = 100,
    bool inverse = false,
  }) {
    final bad = inverse ? value / maximum > .55 : value / maximum < .3;
    return Column(
      children: [
        Row(
          children: [
            Expanded(
              child: Text(label, style: TextStyle(fontSize: 11, color: muted)),
            ),
            Text(
              '$value${maximum == 100 ? '/100' : '/$maximum'}',
              style: TextStyle(fontSize: 10, color: bad ? terracotta : forest),
            ),
          ],
        ),
        const SizedBox(height: 7),
        ClipRRect(
          borderRadius: BorderRadius.circular(4),
          child: LinearProgressIndicator(
            minHeight: 4,
            value: (value / maximum).clamp(0, 1),
            backgroundColor: line,
            color: bad ? terracotta : const Color(0xFF9AA98C),
          ),
        ),
      ],
    );
  }

