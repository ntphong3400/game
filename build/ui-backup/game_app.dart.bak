      ),
      if (s.stability <= 20) ...[
        const SizedBox(height: 18),
        Surface(
          child: Text(
            'Ổn định triều đình nguy cấp: còn ${s.stability}/100. Chạm 0 sẽ bị phế truất ngay, kể cả khi uy quyền hoặc quân lực còn cao. Hãy hòa giải các phe, xử lý tấu chương và tránh quyết định làm triều đình chia rẽ thêm.',
            key: const ValueKey('court-collapse-warning'),
            style: TextStyle(fontSize: 12, height: 1.8, color: terracotta),
          ),
        ),
      ],
      if (s.authority <= 20)
        _criticalWarning(
          'authority-zero-warning',
          'Uy quyền nguy cấp: còn ${s.authority}/100. Chạm 0, nhà vua trở thành bù nhìn và lượt trị vì kết thúc, kể cả khi triều đình còn ổn định. Hãy chấn chỉnh triều chính, củng cố chính danh và tránh quyết định làm mất uy quyền.',
        ),
      if (s.people <= 20)
        _criticalWarning(
          'people-zero-warning',
          'Lòng dân nguy cấp: còn ${s.people}/100. Chạm 0 sẽ bị dân nổi dậy lật đổ, kể cả khi quân lực còn cao. Hãy cứu tế, điều chỉnh thuế và xử lý các tấu chương dân sinh.',
        ),
      if (s.army <= 20)
        _criticalWarning(
          'army-zero-warning',
          'Quân lực nguy cấp: còn ${s.army}/100. Chạm 0, quân đội tan rã; có chiến tranh sẽ mất nước, thời bình sẽ bị đoạt ngôi. Hãy luyện quân, bảo đảm quân lương và tìm cách giảm áp lực chiến tranh.',
        ),
      if (s.health <= 20)
        _criticalWarning(
          'health-zero-warning',
          'Sức khỏe nguy cấp: còn ${s.health}/100. Chạm 0, nhà vua băng hà. Hãy nghỉ ngơi, chữa bệnh và giảm làm việc quá sức hoặc hưởng lạc quá mức.',
        ),
      if (s.affairsThisWeek == 0 || s.neglectedWeeks > 0) ...[
        const SizedBox(height: 18),
        Surface(
          child: Text(
            s.affairsThisWeek == 0
                ? 'Chưa xử lý việc nước ${s.periodName} này.${s.neglectedWeeks > 0 ? ' Đã bỏ bê ${s.neglectedWeeks} ${s.periodName} liên tiếp.' : ''} Sang ${s.periodName} ngay sẽ làm giảm uy quyền, Ổn định triều đình và lòng dân; bỏ bê kéo dài khiến âm mưu tiến triển nhanh hơn. Hãy ban lệnh, tiếp kiến quan hoặc xử lý tấu chương quốc sự.'
                : 'Đã trở lại xử lý việc nước. Chuỗi bỏ bê sẽ kết thúc khi sang ${s.periodName}; uy quyền và lòng tin đã mất cần được gây dựng lại.',
            key: const ValueKey('neglect-warning'),
            style: TextStyle(fontSize: 12, height: 1.8, color: terracotta),
          ),
        ),
      ],
      const SizedBox(height: 28),
      LayoutBuilder(
        builder: (context, bounds) {
          final left = _petitions();
          final right = Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              _section(
                'Việc vua hôm nay',
                trailing: TextButton(
                  onPressed: () => navigate('kingdom'),
                  child: Text('Xem tất cả', style: TextStyle(fontSize: 10)),
                ),
              ),
              Surface(
                child: Column(
                  children: [
                    for (final id in ['govern', 'relief', 'rest', 'revel'])
                      _actionRow(actions.firstWhere((a) => a.id == id)),
                  ],
                ),
              ),
              const SizedBox(height: 22),
              _section('Long thể & nhịp sống'),
              Surface(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    _smallMeter('Mệt mỏi', s.fatigue, inverse: true),
                    const SizedBox(height: 14),
                    _smallMeter('Căng thẳng', s.stress, inverse: true),
                    const SizedBox(height: 16),
                    Text(
                      s.fatigue > 55 || s.indulgence > 5
                          ? 'Cần tiết chế công việc và hưởng lạc. Dành thời gian dưỡng sức.'
                          : 'Nghỉ ngơi và hưởng lạc vừa phải giúp hồi phục. Lạm dụng sẽ gây hại.',
                      style: const TextStyle(fontSize: 10, color: muted),
                    ),
                  ],
                ),
              ),
            ],
          );
          if (bounds.maxWidth < 780) {
            return Column(children: [left, const SizedBox(height: 24), right]);
          }
          return Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Expanded(flex: 6, child: left),
              const SizedBox(width: 24),
              Expanded(flex: 4, child: right),
            ],
          );
        },
      ),
      const SizedBox(height: 26),
      _section('Vừa được ghi vào sử'),
      Surface(
        child: Column(children: s.journal.take(3).map(_journalRow).toList()),
      ),
    ],
  );

  Widget _section(String title, {Widget? trailing}) => Padding(
    padding: const EdgeInsets.only(bottom: 13),
    child: Row(
      children: [
        Expanded(
          child: Text(
            title,
            style: const TextStyle(fontFamily: 'Lora', fontSize: 18),
          ),
        ),
        if (trailing != null) trailing,
      ],
    ),
  );

  Widget _outcomeSummary() {
    final latestWeek = s.outcomes.last.week;
    final latest = s.outcomes.where((r) => r.week == latestWeek).toList();
    return Padding(
      padding: const EdgeInsets.only(top: 16),
      child: Surface(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Cuối ${s.periodName} $latestWeek: ${latest.length} kết quả đã nhận',
              style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 12),
            ),
            const SizedBox(height: 6),
            Text(
              latest
                  .map((r) => '${r.title}: ${r.statusLabel.toLowerCase()}')
                  .join(' · '),
              style: const TextStyle(fontSize: 11, color: muted),
            ),
            TextButton.icon(
              key: const ValueKey('open-outcomes'),
              onPressed:
                  () =>
                      showOutcomeReports(context, latest, seasonal: s.seasonal),
              icon: const Icon(Icons.assignment_turned_in_outlined, size: 16),
              label: const Text('Xem kết quả'),
            ),
          ],
        ),
      ),
    );
  }

  Widget _metrics() {
    final stats = <(String, String, int, IconData)>[
      ('treasury', 'Ngân khố', s.treasury, Icons.toll_outlined),
      ('people', 'Lòng dân', s.people, Icons.groups_outlined),
      ('authority', 'Uy quyền', s.authority, Icons.workspace_premium_outlined),
      ('army', 'Quân lực', s.army, Icons.shield_outlined),
      ('health', 'Sức khỏe', s.health, Icons.favorite_border),
      ('stability', stabilityLabel, s.stability, Icons.balance_outlined),
    ];
    return LayoutBuilder(
      builder: (context, bounds) {
        final columns =
            bounds.maxWidth > 900
                ? 6
                : bounds.maxWidth > 550
                ? 3
                : 2;
        final width = (bounds.maxWidth - (columns - 1) * 12) / columns;
        return Wrap(
          spacing: 12,
          runSpacing: 12,
          children:
              stats.map((stat) {
                final delta = s.deltas[stat.$1] ?? 0;
                final warning = stat.$1 != 'treasury' && stat.$3 < 30;
                return SizedBox(
                  width: width,
                  child: Surface(
                    padding: 16,
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          children: [
                            Icon(
                              stat.$4,
                              size: 17,
                              color: warning ? terracotta : gold,
                            ),
                            const SizedBox(width: 7),
                            Expanded(
                              child: Tooltip(
                                message:
                                    stat.$1 == 'stability'
                                        ? stabilityDescription
                                        : stat.$2,
                                child: SizedBox(
                                  height: 30,
                                  child: Align(
                                    alignment: Alignment.centerLeft,
                                    child: Text(
                                      stat.$2,
                                      maxLines: 2,
                                      style: TextStyle(
                                        fontSize: 10,
                                        color: muted,
                                      ),
                                    ),
                                  ),
                                ),
                              ),
                            ),
                          ],
                        ),
                        const SizedBox(height: 12),
                        Row(
                          crossAxisAlignment: CrossAxisAlignment.end,
                          children: [
                            Expanded(
                              child: FittedBox(
                                fit: BoxFit.scaleDown,
                                alignment: Alignment.centerLeft,
                                child: Text(
                                  '${stat.$3}',
                                  style: TextStyle(
                                    fontFamily: 'Lora',
                                    fontSize: 28,
                                    height: 1.1,
                                    color: warning ? terracotta : ink,
                                  ),
                                ),
                              ),
                            ),
                            const SizedBox(width: 8),
                            Text(
                              delta == 0
                                  ? '—'
                                  : '${delta > 0 ? '↗ +' : '↘ '}$delta',
                              style: TextStyle(
                                fontSize: 10,
                                color: delta < 0 ? terracotta : forest,
                              ),
                            ),
                          ],
                        ),
                        const SizedBox(height: 13),
                        ClipRRect(
                          borderRadius: BorderRadius.circular(4),
                          child: LinearProgressIndicator(
                            value:
                                stat.$1 == 'treasury'
                                    ? (stat.$3 / 800).clamp(0, 1)
                                    : stat.$3 / 100,
                            minHeight: 3,
                            backgroundColor: line,
                            color: warning ? terracotta : Color(0xFF9AA98C),
                          ),
                        ),
                      ],
                    ),
                  ),
                );
              }).toList(),
        );
      },
    );
  }

  Widget _petitions() => Column(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      _section(
        s.seasonal ? 'Tấu chương mùa ${s.season}' : 'Tấu chương trong tuần',
        trailing: Tag('${s.petitions.length} CHỜ NGỰ PHÊ'),
      ),
      if (s.petitions.isEmpty)
        const Surface(
          child: Padding(
            padding: EdgeInsets.symmetric(vertical: 35),
            child: Center(
              child: Column(
                children: [
                  Icon(Icons.check_circle_outline, color: forest, size: 30),
                  SizedBox(height: 14),
                  Text('Triều đình tạm yên việc'),
                  SizedBox(height: 4),
                  Text(
                    'Có thể chăm lo quốc sự hoặc dành thời gian nghỉ ngơi.',
                    textAlign: TextAlign.center,
                    style: TextStyle(fontSize: 11, color: muted),
                  ),
                ],
              ),
            ),
          ),
        ),
      ...([...s.petitions]..sort((a, b) {
        final priorityA =
            a.storyKind == 'major'
                ? 0
                : a.isStory
                ? 1
                : 2;
        final priorityB =
            b.storyKind == 'major'
                ? 0
                : b.isStory
                ? 1
                : 2;
        final compared = priorityA.compareTo(priorityB);
        return compared != 0 ? compared : a.deadline.compareTo(b.deadline);
      })).map((p) {
        final e = eventForState(s, p.definitionId),
            urgent = p.deadline <= s.week;
        return Padding(
          padding: const EdgeInsets.only(bottom: 12),
          child: Surface(
            key: ValueKey('petition-card-${p.id}'),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Tag(
                      e.category.toUpperCase(),
                      color:
                          e.category == 'Khủng hoảng' ||
                                  e.category == 'Âm mưu' ||
                                  p.storyKind == 'major'
                              ? terracotta
                              : gold,
                    ),
                    const Spacer(),
                    Text(
                      urgent
                          ? 'Hạn: cuối ${s.periodName} này'
                          : 'Còn ${p.deadline - s.week + 1} ${s.periodName}',
                      style: TextStyle(
                        fontSize: 9,
                        color: urgent ? terracotta : muted,
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 13),
                Text(
                  e.title,
                  style: const TextStyle(fontFamily: 'Lora', fontSize: 19),
                ),
                const SizedBox(height: 8),
                Text(
                  s.authoredText(petitionText(p, s)),
                  style: TextStyle(fontSize: 12, color: muted, height: 1.8),
                ),
                const SizedBox(height: 16),
                Row(
                  children: [
                    Icon(Icons.history_edu_outlined, size: 16, color: gold),
                    const SizedBox(width: 7),
                    const Expanded(
                      child: Text(
                        'Chờ ý chỉ của bệ hạ',
                        style: TextStyle(fontSize: 10, color: muted),
                      ),
                    ),
                    OutlinedButton(
                      onPressed: busy ? null : () => _petitionDialog(p),
                      child: Text('Ngự phê  →', style: TextStyle(fontSize: 11)),
                    ),
                  ],
                ),
              ],
            ),
          ),
        );
      }),
    ],
  );

  String _petitionExpiryText(Petition p) {
    final e = eventForState(s, p.definitionId);
    final arc = s.chains.where((a) => a.id == p.storyId).firstOrNull;
    if (arc != null && usesChainSettlement(arc)) {
      return '${e.title}\nDừng ở ${arc.completedSteps}/4 và quyết toán: ${chainSettlementRewardText(s, arc)}';
    }
    return '${e.title}\n${e.choices.last.label}: ${e.choices.last.hint}';
  }

  Future<void> _petitionDialog(Petition petition) async {
    final e = eventForState(s, petition.definitionId);
    final arc = s.chains.where((a) => a.id == petition.storyId).firstOrNull;
    final settlement = arc != null && usesChainSettlement(arc);
    bool enabled(int index) {
      if (index < 0) return settlement && s.points >= 1;
      final c = e.choices[index];
      return s.treasury >= c.cost &&
          s.grain >= c.grainCost &&
          s.points >= petitionPoints(s, c) &&
          (!settlement || chainSettlementChoiceBlocked(s, arc, index) == null);
    }

    int? selected;
    var assigneeId = '';
    Courtier? person() => s.court.where((c) => c.id == assigneeId).firstOrNull;
    final choice = await showDialog<(int, String)>(
      context: context,
      builder:
          (context) => StatefulBuilder(
            builder:
                (context, select) => AlertDialog(
                  title: Text(
                    e.title,
                    style: const TextStyle(fontFamily: 'Lora', fontSize: 24),
                  ),
                  content: SizedBox(
                    width: 520,
                    child: SingleChildScrollView(
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Tag(e.category.toUpperCase()),
                          const SizedBox(height: 12),
                          const Text(
                            'Chọn phương án, sau đó bấm “Xác nhận ngự phê” để áp dụng.',
                            style: TextStyle(fontSize: 11, color: muted),
                          ),
                          const SizedBox(height: 18),
                          Text(s.authoredText(petitionText(petition, s))),
                          const SizedBox(height: 20),
                          for (var i = 0; i < e.choices.length; i++)
                            Padding(
                              padding: const EdgeInsets.only(bottom: 10),
                              child: OutlinedButton(
                                key: ValueKey('petition-choice-$i'),
                                onPressed:
                                    !enabled(i)
                                        ? null
                                        : () => select(() {
                                          if (selected != i) {
                                            selected = i;
                                            assigneeId = '';
                                          }
                                        }),
                                style: OutlinedButton.styleFrom(
                                  alignment: Alignment.centerLeft,
                                  padding: const EdgeInsets.all(16),
                                  backgroundColor:
                                      selected == i
                                          ? forest.withValues(alpha: .08)
                                          : null,
                                  side: BorderSide(
                                    color: selected == i ? forest : line,
                                    width: selected == i ? 2 : 1,
                                  ),
                                ),
                                child: SizedBox(
                                  width: double.infinity,
                                  child: Column(
                                    crossAxisAlignment:
                                        CrossAxisAlignment.start,
                                    children: [
                                      Row(
                                        crossAxisAlignment:
                                            CrossAxisAlignment.start,
                                        children: [
                                          Icon(
                                            selected == i
                                                ? Icons.radio_button_checked
                                                : Icons.radio_button_unchecked,
                                            size: 18,
                                            color:
                                                selected == i ? forest : muted,
                                          ),
                                          const SizedBox(width: 8),
                                          Expanded(
                                            child: Text(
                                              e.choices[i].label,
                                              style: const TextStyle(
                                                fontWeight: FontWeight.w600,
                                                fontSize: 13,
                                              ),
                                            ),
                                          ),
                                        ],
                                      ),
                                      const SizedBox(height: 5),
                                      Text(
                                        '${petitionChoiceHint(s, e, e.choices[i], person: selected == i ? person() : null)}${s.seasonal && !petition.isStory ? ' · ${petitionPoints(s, e.choices[i])} hành động' : ''}',
                                        style: const TextStyle(
                                          fontSize: 11,
                                          color: muted,
                                        ),
                                      ),
                                    ],
                                  ),
                                ),
                              ),
                            ),
                          if (settlement && arc.kind == 'haremHarmony')
                            OutlinedButton(
                              key: const ValueKey('chain-stop'),
                              onPressed:
                                  enabled(-1)
                                      ? () => select(() {
                                        selected = -1;
                                        assigneeId = '';
                                      })
                                      : null,
                              child: Text(
                                '${selected == -1 ? '✓ ' : ''}Dừng chuỗi và quyết toán: ${chainSettlementRewardText(s, arc)}',
                              ),
                            ),
                          if (selected != null &&
                              selected! >= 0 &&
                              petitionCanAssign(s, e.choices[selected!])) ...[
                            const SizedBox(height: 8),
                            Text(
                              'Người xử lý · chuyên môn ${petitionSpecialty(e, e.choices[selected!])}',
                              style: const TextStyle(
                                fontWeight: FontWeight.w600,
                              ),
                            ),
                            const SizedBox(height: 8),
                            OutlinedButton(
                              key: const ValueKey('petition-assignee'),
                              onPressed: () async {
                                final id = await _choosePetitionAssignee(
                                  e,
                                  e.choices[selected!],
                                );
                                if (id != null && context.mounted) {
                                  select(() => assigneeId = id);
                                }
                              },
                              child: Text(
                                person()?.name ??
                                    'Không giao ai xử lý (mặc định)',
                              ),
                            ),
                            Text(
                              'Tỷ lệ thành công: ${petitionChance(s, e, e.choices[selected!], person())}%',
                              key: const ValueKey('petition-success-chance'),
                              style: const TextStyle(
                                color: forest,
                                fontWeight: FontWeight.w600,
                              ),
                            ),
                            const SizedBox(height: 6),
                            const Text(
                              'Giao người không tốn thêm hành động. Người được giao sẽ bận đến khi có kết quả. Để mặc định sẽ không tự chọn người thay bạn.',
                              style: TextStyle(
                                fontSize: 11,
                                color: muted,
                                height: 1.6,
                              ),
                            ),
                            const SizedBox(height: 18),
                          ],
                          Text(
                            settlement
                                ? 'Quá hạn sẽ dừng chuỗi và quyết toán theo số bước đã hoàn thành; không thu thêm chi phí hay hoàn thành bước đang chờ.'
                                : petition.isStory
                                ? 'Bỏ quá hạn sẽ áp dụng lựa chọn cuối cùng và quyết định diễn biến bản tấu sau.${petition.storyKind == 'major' ? ' Tổn thất có thể làm chỉ số về 0 và kết thúc triều đại.' : ''}'
                                : 'Bỏ quá hạn sẽ áp dụng lựa chọn cuối cùng. Tấu chương khủng hoảng/âm mưu bị bỏ mặc còn làm mất uy quyền và Ổn định triều đình.',
                            style: TextStyle(fontSize: 10, color: terracotta),
                          ),
                        ],
                      ),
                    ),
                  ),
                  actions: [
                    TextButton(
                      onPressed: () => Navigator.pop(context),
                      child: const Text('Đọc sau'),
                    ),
                    FilledButton(
                      key: const ValueKey('confirm-petition'),
                      onPressed:
                          selected == null || !enabled(selected!)
                              ? null
                              : () => Navigator.pop(context, (
                                selected!,
                                assigneeId,
                              )),
                      child: const Text('Xác nhận ngự phê'),
                    ),
                  ],
                ),
          ),
    );
    if (choice != null) {
      await act(
        'petition',
        target: petition.id,
        option: choice.$1 < 0 ? 'abandon' : '${choice.$1}',
        assigneeId: choice.$2,
      );
    }
  }

  Future<String?> _choosePetitionAssignee(
    EventDefinition e,
    EventChoice c,
  ) => showDialog<String>(
    context: context,
    builder:
        (context) => SimpleDialog(
          title: const Text('Chọn người xử lý tấu chương'),
          children: [
            SimpleDialogOption(
              key: const ValueKey('petition-unassigned'),
              onPressed: () => Navigator.pop(context, ''),
              child: Text('Không giao ai xử lý · ${petitionBaseChance(c)}%'),
            ),
            if (petitionAssignees(s, e, c).isEmpty)
              const Padding(
                padding: EdgeInsets.all(24),
                child: Text(
                  'Chưa có triều thần hoặc người trong hậu cung đủ điều kiện và đang rảnh.',
                ),
              ),
            for (final p in petitionAssignees(s, e, c))
              SimpleDialogOption(
                key: ValueKey('petition-person-${p.id}'),
                onPressed: () => Navigator.pop(context, p.id),
                child: Padding(
                  padding: const EdgeInsets.symmetric(vertical: 7),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text('${p.name} · ${p.displayRole}'),
                      Text(
                        '${p.specialty} · năng lực ${p.ability} · mệt ${p.strain} · bất mãn ${p.discontent}\n${petitionChance(s, e, c, p)}% thành công',
                        style: const TextStyle(fontSize: 11, color: muted),
                      ),
                    ],
                  ),
                ),
              ),
          ],
        ),
  );

  IconData _actionIcon(String key) => switch (key) {
    'court' => Icons.account_balance_outlined,
    'people' => Icons.volunteer_activism_outlined,
    'army' => Icons.shield_outlined,
    'levee' => Icons.water_outlined,
    'grain' => Icons.grass_outlined,
    'health' => Icons.spa_outlined,
    'revel' => Icons.music_note_outlined,
    'security' => Icons.security_outlined,
    'treasury' => Icons.savings_outlined,
    _ => Icons.public_outlined,
  };

  Widget _actionRow(ActionDefinition a) => Padding(
    padding: const EdgeInsets.symmetric(vertical: 8),
    child: Row(
      children: [
        Container(
          width: 37,
          height: 37,
          decoration: BoxDecoration(
            color: parchment,
            borderRadius: BorderRadius.circular(8),
          ),
          child: Icon(_actionIcon(a.icon), size: 19, color: forest),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                a.title,
                style: TextStyle(fontSize: 12, fontWeight: FontWeight.w600),
              ),
              const SizedBox(height: 3),
              Text(
                s.authoredText(
                  (a.id == 'treat'
                          ? treatmentActionDescription(
                            s,
                            baseCost: a.cost,
                            cost: actionCost(s, a),
                          )
                          : null) ??
                      revenueTaskBlocked(s, a.id) ??
                      (a.id == 'security' ? securityBlocked(s) : null) ??
                      careActionDescription(s, a.id) ??
                      seasonalActionDescription(s, a.id) ??
                      a.description,
                ),
                style: const TextStyle(fontSize: 9, color: muted),
              ),
            ],
          ),
        ),
        const SizedBox(width: 6),
        IconButton(
          key: ValueKey('action-${a.id}'),
          tooltip: a.title,
          onPressed:
              busy ||
                      s.points < 1 ||
                      s.treasury < actionCost(s, a) ||
                      s.grain < a.grainCost ||
                      (revenueTaskBlocked(s, a.id) != null ||
                          (a.id == 'security' && securityBlocked(s) != null)) ||
                      (a.id == 'mediate' && (s.actionCounts[a.id] ?? 0) > 0)
                  ? null
                  : () => _performAction(a),
          icon: const Icon(Icons.arrow_outward, size: 18),
          color: forest,
        ),
      ],
    ),
  );

  EdgeInsets _personnelDialogInsets(BuildContext context) {
    final width = MediaQuery.sizeOf(context).width;
    return EdgeInsets.symmetric(
      horizontal: width > 760 ? (width - 680) / 2 : 24,
      vertical: 24,
    );
  }

  Future<void> _performAction(ActionDefinition a) async {
    String officer = '';
    if (taskSpecialties.containsKey(a.id)) {
      final result = await showDialog<String>(
        context: context,
        builder:
            (context) => SimpleDialog(
              insetPadding: _personnelDialogInsets(context),
              title: Text(
                'Giao ai phụ trách ${a.title.toLowerCase()}?',
                style: TextStyle(fontFamily: 'Lora'),
              ),
              children: [
                Padding(
                  padding: const EdgeInsets.fromLTRB(24, 0, 24, 16),
                  child: Text(
                    'Cần chuyên môn ${taskSpecialties[a.id]}. Ước tính dựa trên năng lực, chuyên môn, mệt mỏi, quan hệ và tính cách đã biết. Phẩm chất chưa rõ có thể đổi kết quả; thành công không được bảo đảm. Người đang làm công việc dài hạn không có trong danh sách. ${taskFailureHint(a.id)}',
                    style: const TextStyle(fontSize: 12, height: 1.7),
                  ),
                ),
                ...taskOfficers(s, a.id).map(
                  (c) => SimpleDialogOption(
                    key: ValueKey('assign-${a.id}-${c.id}'),
                    onPressed: () => Navigator.pop(context, c.id),
                    child: Padding(
                      padding: const EdgeInsets.symmetric(vertical: 7),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            '${c.name} · ${c.displayRole}',
                            style: const TextStyle(fontWeight: FontWeight.w600),
                          ),
                          const SizedBox(height: 5),
                          Text(
                            'Năng lực ${c.ability} · ${c.specialty} · mệt ${c.strain}/100\n${personalityWorkHint(s, c)}',
                            style: const TextStyle(fontSize: 12),
                          ),
                          Text(
                            '${fitLabel(TaskAssessment.preview(a.id, c, s).fit)} · ước tính thành công ${TaskAssessment.preview(a.id, c, s).successChance}% · mức thu ${TaskAssessment.preview(a.id, c, s).rewardPercent}% cơ bản',
                            style: TextStyle(
                              fontSize: 11,
                              color:
                                  TaskAssessment.preview(a.id, c, s).fit == 20
                                      ? terracotta
                                      : forest,
                            ),
                          ),
                          if (revenueTasks.contains(a.id)) ...[
                            const SizedBox(height: 5),
                            Text(
                              revenueRewardPreview(a.id, c, s),
                              style: const TextStyle(fontSize: 11),
                            ),
                          ],
                        ],
                      ),
                    ),
                  ),
                ),
                if (taskOfficers(s, a.id).isEmpty)
                  const Padding(
                    padding: EdgeInsets.all(24),
                    child: Text(
                      'Chưa có người rảnh để nhận việc. Hãy chờ công việc đang chạy hoàn tất.',
                    ),
                  ),
              ],
            ),
      );
      if (result == null || !mounted) return;
      officer = result;
      final person = s.court.firstWhere((c) => c.id == result);
      final yes = await showDialog<bool>(
        context: context,
        builder:
            (context) => AlertDialog(
              insetPadding: _personnelDialogInsets(context),
              title: Text(
                'Giao việc cho ${person.name}',
                style: const TextStyle(fontFamily: 'Lora'),
              ),
              content: SingleChildScrollView(
                child: Text(
                  '${a.title}\nChuyên môn ${person.specialty} · năng lực ${person.ability}/100\n${fitLabel(TaskAssessment.preview(a.id, person, s).fit)} · ước tính thành công ${TaskAssessment.preview(a.id, person, s).successChance}%\n\nChi ${actionCost(s, a)} tiền${a.grainCost > 0 ? ' và ${a.grainCost} lương thực' : ''}, 1 hành động. Mức thu khi thành công: ${TaskAssessment.preview(a.id, person, s).rewardPercent}% cơ bản; thành quả có thể bị thất thoát tùy liêm chính.\n${personalityWorkHint(s, person)}\n\n${revenueTasks.contains(a.id) ? '${revenueRewardPreview(a.id, person, s)}\n\n' : ''}${taskFailureHint(a.id)} Kinh phí không hoàn lại khi thất bại.',
                  style: const TextStyle(height: 1.8),
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(context, false),
                  child: const Text('Cân nhắc lại'),
                ),
                FilledButton(
                  onPressed: () => Navigator.pop(context, true),
                  child: const Text('Xác nhận giao việc'),
                ),
              ],
            ),
      );
      if (yes != true) return;
    }
    await act('action', target: a.id, option: officer);
  }

  Widget _kingdom() => Column(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      _heading(
        'Quốc sự',
        'Điều hành triều chính, giữ vững biên cương và lòng dân.',
      ),
      _metrics(),
      const SizedBox(height: 18),
      _reignPanel(),
      const SizedBox(height: 26),
      _section('Ban hành công việc'),
      _actionGrid(
        actions
            .where(
              (a) =>
                  ![
                    'rest',
                    'revel',
                    'treat',
                    'buy_grain',
                    'repair',
                    'relief',
                    ...revenueTasks,
                  ].contains(a.id),
            )
            .toList(),
      ),
      const SizedBox(height: 26),
      _ongoingWork(),
      const SizedBox(height: 26),
      Surface(child: OutcomePanel(reports: s.outcomes, seasonal: s.seasonal)),
    ],
  );

  Widget _treasury() => Column(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      _heading(
        'Ngân khố',
        'Quản lý nguồn thu, thuế, kho lương, đê điều và sổ thu chi.',
      ),
      _metrics(),
      const SizedBox(height: 18),
      Surface(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            _section('Lương thực và đê điều'),
            _smallMeter('Lương thực dự trữ', s.grain, maximum: 200),
            const SizedBox(height: 18),
            _smallMeter('Tình trạng đê điều', s.levee),
            const SizedBox(height: 20),
            Wrap(
              spacing: 22,
              runSpacing: 12,
              children: [
                Text(
                  'Nợ chi trả: ${s.debt}',
                  style: TextStyle(color: s.debt > 0 ? terracotta : muted),
                ),
                Text(
                  s.war == 0
                      ? 'Biên giới: tạm yên'
                      : 'Chiến tranh: mức ${s.war} · áp sát kinh thành ${s.siege}/4',
                  style: TextStyle(color: s.war > 0 ? terracotta : forest),
                ),
              ],
            ),
            const SizedBox(height: 22),
            const Divider(),
            const SizedBox(height: 12),
            const Text(
              'Thu thuế và ưu tiên ngân sách',
              style: TextStyle(fontWeight: FontWeight.w600),
            ),
            const SizedBox(height: 12),
            if (s.seasonal)
              const Text(
                'Mức thuế cho kỳ thu hoạch tới',
                style: TextStyle(fontSize: 12, fontWeight: FontWeight.w600),
              ),
            Wrap(
              spacing: 8,
              runSpacing: 8,
              children: [
                for (var i = 0; i < 3; i++)
                  ChoiceChip(
                    label: Text('Thuế ${['nhẹ', 'vừa', 'cao'][i]}'),
                    selected: s.tax == i,
                    onSelected:
                        busy || s.points == 0
                            ? null
                            : (_) => act('tax', option: '$i'),
                  ),
              ],
            ),
            const SizedBox(height: 12),
            Wrap(
              spacing: 8,
              runSpacing: 8,
              children: [
                ChoiceChip(
                  label: const Text('Ưu tiên quân đội'),
                  selected: s.priority == 'army',
                  onSelected:
                      busy || s.points == 0
                          ? null
                          : (_) => act('priority', option: 'army'),
                ),
                ChoiceChip(
                  label: const Text('Ưu tiên cứu tế'),
                  selected: s.priority == 'people',
                  onSelected:
                      busy || s.points == 0
                          ? null
                          : (_) => act('priority', option: 'people'),
                ),
              ],
            ),
            const SizedBox(height: 10),
            Text(
              s.seasonal
                  ? '${taxPolicyHint(s)}\nĐổi mức thuế tốn 1 hành động. Chỉ thu tiền và áp dụng tác động lòng dân khi khép mùa Thu: nhẹ +4, vừa 0, cao −8.'
                  : 'Thay chính sách tốn 1 hành động. Thuế cao tăng nguồn thu nhưng làm lòng dân giảm mỗi ${s.periodName}.',
              key: const ValueKey('tax-policy-timing'),
              style: TextStyle(fontSize: 10, color: muted),
            ),
          ],
        ),
      ),
      const SizedBox(height: 26),
      _section('Tăng ngân khố'),
      _actionGrid(actions.where((a) => revenueTasks.contains(a.id)).toList()),
      const SizedBox(height: 26),
      _section('Chăm lo lương thực và đê điều'),
      _actionGrid(
        actions
            .where((a) => ['buy_grain', 'repair', 'relief'].contains(a.id))
            .toList(),
      ),
      const SizedBox(height: 26),
      _ongoingWork(),
      const SizedBox(height: 26),
      Surface(child: FinancePanel(state: s)),
    ],
  );

  Widget _ongoingWork() => Column(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      _section('Đang thực hiện'),
      Surface(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            if (s.projects.isEmpty && s.pending.isEmpty)
              const Text(
                'Chưa có công việc dài hạn. Hãy chọn người và giao việc.',
                style: TextStyle(color: muted),
              ),
            ...s.projects.map(
              (p) => Padding(
                padding: const EdgeInsets.only(bottom: 16),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      '${projectTitle(p.kind)} · ${s.court.firstWhere((c) => c.id == p.officerId).name}',
                      style: const TextStyle(fontSize: 12),
                    ),
                    const SizedBox(height: 8),
                    LinearProgressIndicator(
                      value: p.progress / p.duration,
                      backgroundColor: line,
                      color: forest,
                    ),
                    const SizedBox(height: 6),
                    Text(
                      '${p.progress}/${p.duration} kỳ · dự kiến cuối ${s.date(p.startedWeek + p.duration - 1)} · khi hoàn tất sẽ xét chuyên môn và năng lực; có thể thất bại',
                      style: const TextStyle(fontSize: 10, color: muted),
                    ),
                  ],
                ),
              ),
            ),
            ...s.pending.map(
              (p) => Padding(
                padding: const EdgeInsets.symmetric(vertical: 7),
                child: Row(
                  children: [
                    const Icon(Icons.schedule_outlined, size: 16, color: gold),
                    const SizedBox(width: 10),
                    Expanded(
                      child: Text(
                        '${p.title.isNotEmpty ? p.title : _pendingName(p.kind)} · dự kiến cuối ${s.date(p.dueWeek)}${p.assignment == null ? '' : '\n${p.assignment!.personLabel} · ${p.assignment!.chance}% thành công'}',
                        style: const TextStyle(fontSize: 11),
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    ],
  );

  String _pendingName(String key) => switch (key) {
    'envoy' => 'Sứ đoàn hòa đàm',
    'investigate' => 'Điều tra nhân vật',
    'audit' => 'Kiểm toán',
    'trade' => 'Thương lộ',
    'school' => 'Xây lớp học',
    'weapons' => 'Quân khí',
    'security' => 'Điều tra tin mật',
    _ => key,
  };

  Widget _actionGrid(List<ActionDefinition> definitions) => LayoutBuilder(
    builder: (context, bounds) {
      final columns =
          bounds.maxWidth > 850
              ? 3
              : bounds.maxWidth > 540
              ? 2
              : 1;
      return Wrap(
        spacing: 12,
        runSpacing: 12,
        children:
            definitions
                .map(
                  (a) => SizedBox(
                    width: (bounds.maxWidth - (columns - 1) * 12) / columns,
                    child: Surface(padding: 16, child: _actionRow(a)),
                  ),
                )
                .toList(),
      );
    },
  );

  Widget _people(bool harem) {
    final all =
        s.court.where((c) => c.available && c.isConsort == harem).toList();
    final selectedCategory = harem ? haremCategory : courtCategory;
    final selectedFaction = harem ? haremFaction : courtFaction;
    final search = harem ? haremSearch : courtSearch;
    final query = search.text.trim().toLowerCase();
    final categories = [
      'Tất cả',
      if (harem) ...[
        'Hoàng hậu',
        'Phi tần',
        'Tú nữ',
      ] else
        ...officialCategories,
    ];
    final people =
        all
            .where(
              (c) =>
                  (selectedCategory == 'Tất cả' ||
                      c.category == selectedCategory) &&
                  (selectedFaction == 'Tất cả' ||
                      c.faction == selectedFaction) &&
                  '${c.name} ${c.displayRole} ${c.faction}'
                      .toLowerCase()
                      .contains(query),
            )
            .toList();
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _heading(
          harem ? 'Sau rèm châu' : 'Những người bên ngai vàng',
          harem
              ? 'Bồi dưỡng tài năng, giao cung vụ và chăm lo tình cảm trong cung.'
              : 'Biết dùng người là một nửa việc trị nước. Biết lòng người là nửa còn lại.',
        ),
        if (harem && s.seasonal) ...[
          PalacePanel(
            state: s,
            busy: busy,
            onAssign:
                (personId, option) =>
                    act('palace', target: personId, option: option),
          ),
          const SizedBox(height: 20),
          const Text(
            'Nhân vật hậu cung',
            style: TextStyle(fontFamily: 'Lora', fontSize: 20),
          ),
          const SizedBox(height: 12),
        ],
        Surface(
          padding: 18,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  Icon(Icons.account_tree_outlined, size: 18, color: gold),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Text(
                      harem
                          ? '${all.where((c) => c.inHarem).length} người trong cung · ${all.where((c) => !c.inHarem).length} ứng viên'
                          : '${all.length} triều thần · 5 nhóm chức vụ · 4 phe',
                      style: const TextStyle(
                        fontWeight: FontWeight.w600,
                        fontSize: 12,
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 14),
              Wrap(
                spacing: 8,
                runSpacing: 8,
                children:
                    categories.map((category) {
                      final count =
                          category == 'Tất cả'
                              ? all.length
                              : all.where((c) => c.category == category).length;
                      return ChoiceChip(
                        key: ValueKey('catalog-$harem-$category'),
                        label: Text(
                          '$category ($count)',
                          style: const TextStyle(fontSize: 11),
                        ),
                        selected: selectedCategory == category,
                        onSelected:
                            (_) => setState(() {
                              if (harem) {
                                haremCategory = category;
                              } else {
                                courtCategory = category;
                              }
                            }),
                      );
                    }).toList(),
              ),
              const SizedBox(height: 16),
              LayoutBuilder(
                builder:
                    (context, bounds) => Wrap(
                      spacing: 12,
                      runSpacing: 12,
                      children: [
                        SizedBox(
                          width:
                              bounds.maxWidth > 600
                                  ? bounds.maxWidth - 222
                                  : bounds.maxWidth,
                          child: TextField(
                            key: ValueKey('people-search-$harem'),
                            controller: search,
                            onChanged: (_) => setState(() {}),
                            decoration: const InputDecoration(
                              isDense: true,
                              prefixIcon: Icon(Icons.search, size: 20),
                              hintText: 'Tìm tên, chức vụ hoặc phe…',
                            ),
                          ),
                        ),
                        SizedBox(
                          width: bounds.maxWidth > 600 ? 210 : bounds.maxWidth,
                          child: DropdownButtonFormField<String>(
                            key: ValueKey('faction-filter-$harem'),
                            value: selectedFaction,
                            isExpanded: true,
                            decoration: const InputDecoration(
                              isDense: true,
                              labelText: 'Phe phái',
                            ),
                            items:
                                ['Tất cả', ...factionOpponents.keys]
                                    .map(
                                      (faction) => DropdownMenuItem(
                                        value: faction,
                                        child: Text(
                                          faction == 'Tất cả'
                                              ? 'Tất cả các phe'
                                              : faction,
                                          style: const TextStyle(fontSize: 12),
                                        ),
                                      ),
                                    )
                                    .toList(),
                            onChanged:
                                (value) => setState(() {
                                  if (harem) {
                                    haremFaction = value!;
                                  } else {
                                    courtFaction = value!;
                                  }
                                }),
                          ),
                        ),
                      ],
                    ),
              ),
              const SizedBox(height: 12),
              Text(
                'Đang xem ${people.length}/${all.length} người',
                style: const TextStyle(fontSize: 10, color: muted),
              ),
            ],
          ),
        ),
        const SizedBox(height: 18),
        if (harem)
          ExpansionTile(
            title: const Text(
              'Gia tộc & tuyển phi',
              style: TextStyle(fontSize: 12),
            ),
            children: [
              Padding(
                padding: const EdgeInsets.all(12),
                child: Text(
                  '${s.seasonal ? 'Từ mùa Hạ năm 1, gia tộc có thể tiến cử người mới mỗi mùa' : 'Từ tuần 4 và mỗi 13 tuần, gia tộc sẽ tiến cử người mới'}. Nạp phi và phong hậu tăng ảnh hưởng gia tộc nhưng khiến phe đối lập bất mãn.',
                  style: const TextStyle(fontSize: 11, color: muted),
                ),
              ),
            ],
          )
        else
          Surface(
            padding: 16,
            child: Text(
              'Phe ${s.hostileFaction} dè chừng từ đầu. Văn thần ↔ Võ tướng; Hoàng tộc ↔ Thế gia. Tiếp kiến, ban thưởng làm phe đối lập giảm thiện cảm; lặp lại và quan hệ cao có lợi ích thấp hơn.',
              style: const TextStyle(fontSize: 11, color: muted),
            ),
          ),
        const SizedBox(height: 20),
        if (!harem) ...[
          Wrap(
            spacing: 10,
            runSpacing: 10,
            children:
                s.factions.entries
                    .map(
                      (e) => Tag(
                        '${e.key.toUpperCase()}  ${e.value}',
                        color: e.value < 35 ? terracotta : forest,
                      ),
                    )
                    .toList(),
          ),
          const SizedBox(height: 24),
        ],
        if (people.isEmpty)
          const Surface(
            child: Text(
              'Không có nhân vật phù hợp. Hãy đổi phân loại, phe hoặc từ tìm kiếm.',
              style: TextStyle(color: muted),
            ),
          ),
        LayoutBuilder(
          builder: (context, bounds) {
            final columns =
                bounds.maxWidth > 1050
                    ? 3
                    : bounds.maxWidth > 600
                    ? 2
                    : 1;
            return Wrap(
              spacing: 16,
              runSpacing: 16,
              children:
                  people
                      .map(
                        (c) => SizedBox(
                          width:
                              (bounds.maxWidth - (columns - 1) * 16) / columns,
                          child: Surface(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Row(
                                  children: [
                                    CircleAvatar(
                                      radius: 24,
                                      backgroundColor:
                                          harem
                                              ? const Color(0xFFEDE3DB)
                                              : const Color(0xFFE6E9DF),
                                      child: Icon(
                                        harem
                                            ? Icons.local_florist_outlined
                                            : Icons.person_outline,
                                        color: harem ? terracotta : forest,
                                      ),
                                    ),
                                    const SizedBox(width: 12),
                                    Expanded(
                                      child: Column(
                                        crossAxisAlignment:
                                            CrossAxisAlignment.start,
                                        children: [
                                          Text(
                                            c.name,
                                            style: const TextStyle(
                                              fontFamily: 'Lora',
                                              fontSize: 18,
                                            ),
                                          ),
                                          const SizedBox(height: 4),
                                          Text(
                                            '${c.displayRole} · ${c.age} tuổi',
                                            style: const TextStyle(
                                              fontSize: 10,
                                              color: gold,
                                            ),
                                          ),
                                        ],
                                      ),
                                    ),
                                  ],
                                ),
                                const SizedBox(height: 16),
                                Tag(c.faction.toUpperCase()),
                                const SizedBox(height: 12),
                                Text(
                                  'Đã biết: ${c.knownPersonalityText}\n${c.personalityProgress}',
                                  style: TextStyle(fontSize: 11, color: muted),
                                ),
                                const SizedBox(height: 16),
                                _smallMeter('Năng lực', c.ability),
                                const SizedBox(height: 6),
                                Text(
                                  harem && s.seasonal
                                      ? palaceProgress(s, c)
                                      : 'Chuyên môn: ${c.specialty} · xem chú thích khi triệu kiến',
                                  style: TextStyle(fontSize: 10, color: muted),
                                ),
                                if (harem && s.seasonal) ...[
                                  const SizedBox(height: 6),
                                  Text(
                                    c.ability >= 100
                                        ? 'Năng lực đã tối đa'
                                        : 'Kinh nghiệm ${c.palaceExperience}/${palaceExperienceNeeded(c.ability)} · ${c.palaceDutiesCompleted} cung vụ · ${c.palaceCoursesCompleted} khóa học',
                                    style: const TextStyle(
                                      fontSize: 10,
                                      color: muted,
                                    ),
                                  ),
                                  ExpansionTile(
                                    tilePadding: EdgeInsets.zero,
                                    title: const Text(
                                      'Đóng góp & điều kiện',
                                      style: TextStyle(fontSize: 11),
                                    ),
                                    children: [
                                      Text(
                                        haremPassivePreview(c),
                                        key: ValueKey('harem-passive-${c.id}'),
                                        style: const TextStyle(
                                          fontSize: 10,
                                          color: forest,
                                        ),
                                      ),
                                    ],
                                  ),
                                ],
                                const SizedBox(height: 12),
                                _smallMeter('Thiện cảm', c.affection),
                                const SizedBox(height: 12),
                                Tooltip(
                                  message:
                                      'Bất mãn cao làm giảm hợp tác. Từ 60, người có trung thành thấp có thể nuôi âm mưu; chức vị cao có tham vọng lớn có thể đảo chính.',
                                  child: KeyedSubtree(
                                    key: ValueKey('discontent-${c.id}'),
                                    child: _smallMeter(
                                      'Bất mãn',
                                      c.discontent,
                                      inverse: true,
                                    ),
                                  ),
                                ),
                                const SizedBox(height: 14),
                                Text(
                                  c.qualitiesText,
                                  key: ValueKey('qualities-${c.id}'),
                                  style: TextStyle(
                                    fontSize: 10,
                                    color: c.investigated ? forest : muted,
                                  ),
                                ),
                                const SizedBox(height: 18),
                                SizedBox(
                                  width: double.infinity,
                                  child: OutlinedButton(
                                    onPressed:
                                        busy ? null : () => _personDialog(c),
                                    child: Text(
                                      harem
                                          ? (c.inHarem ? 'Tiếp kiến' : 'Gặp gỡ')
                                          : 'Triệu kiến',
                                      style: const TextStyle(fontSize: 11),
                                    ),
                                  ),
                                ),
                              ],
                            ),
                          ),
                        ),
                      )
                      .toList(),
            );
          },
        ),
      ],
    );
  }

  Future<void> _personDialog(Courtier c) async {
    final options = <(String, String, String, int)>[
      (
        'audience',
        'Trò chuyện, lắng nghe',
        '1 hành động · thiện cảm cơ bản +6 và giảm bất mãn theo mức thực nhận; tùy tính cách, lặp/quan hệ cao giảm hiệu quả · thái độ phe đối lập −3; mỗi nhân vật phe đó −2 thiện cảm, gồm tú nữ/phi tần; đồng thời +2 bất mãn · mỗi 3 lần mở thêm 1 tính cách',
        0,
      ),
      (
        'reward',
        'Ban thưởng',
        '1 hành động · chi 25 · thiện cảm cơ bản +8 và giảm bất mãn theo mức thực nhận, tùy tính cách · phe đối lập −3 thiện cảm và +3 bất mãn',
        25,
      ),
      (
        'investigate',
        'Điều tra kín',
        '1 hành động · chi ${investigationCost(s)} · kết quả cuối ${s.date(s.week + investigationDuration(s) - 1)}; âm mưu lớn khó lấy chứng cứ${s.seasonal ? ', thành công giảm 6 tiến độ của người bị điều tra' : ''}',
        investigationCost(s),
      ),
      if (!c.isConsort)
        (
          'dismiss',
          'Bãi chức, thay người',
          'Chọn ứng viên · 1 hành động · phí theo năng lực, địa vị và chức vụ · ảnh hưởng các phe',
          0,
        ),
      if (c.isConsort && !c.inHarem)
        (
          'invite',
          'Tuyển vào hậu cung',
          '1 hành động · chi 35 · sinh hoạt +${s.seasonal ? 6 : 2} tiền/${s.periodName} · mỗi nhân vật phe đối lập −2 thiện cảm${s.seasonal ? '\n${haremPassivePreview(c)}' : ''}',
          35,
        ),
      if (c.inHarem && !c.queen)
        (
          'queen',
          'Sắc phong Hoàng hậu',
          '1 hành động · chi 60 · ảnh hưởng các gia tộc${s.seasonal ? '\n${haremPassivePreview(c, asQueen: true)}' : ''}',
          60,
        ),
      if (c.inHarem && c.isConsort && s.seasonal) ...[
        ('palace-duty', 'Giao cung vụ', palaceProgress(s, c), 0),
        (
          'palace-study',
          'Theo học trong cung',
          '20 tiền · 1 hành động · 2 mùa · ${palaceProgress(s, c)}',
          20,
        ),
      ],
      if (c.inHarem)
        (
          'visit',
          'Cùng dạo Ngự uyển',
          '1 hành động · chi 10 · thêm 1 lần hưởng lạc',
          10,
        ),
    ];
    final option = await showDialog<String>(
      context: context,
      builder:
          (context) => SimpleDialog(
            insetPadding: _personnelDialogInsets(context),
            title: Text(c.name, style: const TextStyle(fontFamily: 'Lora')),
            children: [
              Padding(
                padding: const EdgeInsets.fromLTRB(24, 0, 24, 18),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      '${c.displayRole} · ${c.faction} · ${c.age} tuổi',
                      style: const TextStyle(color: gold, fontSize: 12),
                    ),
                    const SizedBox(height: 12),
                    Text(
                      'Đã biết: ${c.knownPersonalityText}\n${c.personalityProgress}\n${c.knownPersonalities.map((p) => '${p.label}: ${p.description}').join('\n')}',
                      key: const ValueKey('personality-details'),
                      style: const TextStyle(fontSize: 12, height: 1.7),
                    ),
                    const SizedBox(height: 8),
                    Text(
                      abilityExplanation(c),
                      key: const ValueKey('person-ability-help'),
                      style: const TextStyle(fontSize: 12, height: 1.8),
                    ),
                    const SizedBox(height: 8),
                    Text(
                      s.calendarText(
                        c.isConsort && s.seasonal
                            ? haremPassivePreview(c)
                            : '${roleAbilityExplanation(c)}\n${officerWorkHint(c, s)}',
                      ),
                      style: const TextStyle(
                        fontSize: 12,
                        color: forest,
                        height: 1.8,
                      ),
                    ),
                    const SizedBox(height: 8),
                    const Text(
                      'Năng lực cao không bảo đảm trung thành hay liêm chính. Các phẩm chất chưa điều tra vẫn chưa được xác minh.',
                      style: TextStyle(fontSize: 11, color: muted, height: 1.7),
                    ),
                  ],
                ),
              ),
              ...options.map(
                (option) => SimpleDialogOption(
                  onPressed:
                      s.points < 1 || s.treasury < option.$4
                          ? null
                          : () => Navigator.pop(context, option.$1),
                  child: Opacity(
                    opacity: s.points < 1 || s.treasury < option.$4 ? .35 : 1,
                    child: Padding(
                      padding: const EdgeInsets.symmetric(vertical: 8),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            option.$2,
                            style: TextStyle(
                              fontWeight: FontWeight.w600,
                              color: option.$1 == 'dismiss' ? terracotta : ink,
                            ),
                          ),
                          const SizedBox(height: 5),
                          Text(
                            option.$3,
                            style: const TextStyle(fontSize: 11, color: muted),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ),
            ],
          ),
    );
    if (option == 'dismiss') {
      await _replacementDialog(c);
    } else if (option == 'palace-duty' && mounted) {
      await choosePalaceDuty(
        context,
        s,
        (id, option) => act('palace', target: id, option: option),
        person: c,
      );
    } else if (option == 'palace-study' && mounted) {
      await choosePalaceStudy(
        context,
        s,
        (id, option) => act('palace', target: id, option: option),
        person: c,
      );
    } else if (option != null) {
      await act('courtier', target: c.id, option: option);
    }
  }

  Future<void> _replacementDialog(Courtier outgoing) async {
    final candidates = [...s.officialsPool]..sort((a, b) {
      final fit = specialtyFit(
        b.specialty,
        specialtyForRole(outgoing.role),
      ).compareTo(specialtyFit(a.specialty, specialtyForRole(outgoing.role)));
      return fit != 0 ? fit : b.ability.compareTo(a.ability);
    });
    final chosen = await showDialog<String>(
      context: context,
      builder:
          (context) => SimpleDialog(
            insetPadding: _personnelDialogInsets(context),
            title: Text(
              'Chọn người tiếp nhận chức ${outgoing.role}',
              style: const TextStyle(fontFamily: 'Lora'),
            ),
            children: [
              Padding(
                padding: const EdgeInsets.fromLTRB(24, 0, 24, 16),
                child: Text(
                  'Thay ${outgoing.name}. Ngân khố ${s.treasury}. Mỗi lần thay tốn 1 hành động, Ổn định triều đình −${replacementDisruption(outgoing)}; phí theo năng lực, địa vị (ảnh hưởng) của ứng viên và chức vụ tiếp nhận: bậc ${appointmentRank(outgoing.role)}/4. Chức càng cao, phí càng lớn. Danh sách được giữ khi tải lại. Công việc thường chuyển sang người mới và giữ tiến độ. Tấu chương đã giao riêng cho người bị bãi chức sẽ gián đoạn, không tự chuyển phân công.',
                  style: const TextStyle(fontSize: 12, height: 1.8),
                ),
              ),
              for (final c in candidates)
                SimpleDialogOption(
                  key: ValueKey('appoint-candidate-${c.id}'),
                  onPressed:
                      s.points < 1 ||
                              s.treasury < appointmentCost(c, outgoing.role)
                          ? null
                          : () => Navigator.pop(context, c.id),
                  child: Padding(
                    padding: const EdgeInsets.symmetric(vertical: 8),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          '${c.name} · ${c.faction}',
                          style: const TextStyle(fontWeight: FontWeight.w600),
                        ),
                        const SizedBox(height: 5),
                        Text(
                          'Năng lực ${c.ability} · ${c.specialty} · ${fitLabel(specialtyFit(c.specialty, specialtyForRole(outgoing.role)))}\nĐịa vị: ảnh hưởng ${c.influence}/100 · bất mãn ${c.discontent}/100\nĐã biết: ${c.knownPersonalityText} · tính cách khác chưa rõ',
                          style: const TextStyle(fontSize: 11),
                        ),
                        Text(
                          'Bổ nhiệm: ${appointmentCost(c, outgoing.role)} tiền${s.treasury < appointmentCost(c, outgoing.role) ? ' · Không đủ ngân khố' : ''}',
                          style: TextStyle(
                            fontSize: 12,
                            color:
                                s.treasury < appointmentCost(c, outgoing.role)
                                    ? terracotta
                                    : forest,
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
            ],
          ),
    );
    if (chosen == null || !mounted) return;
    final candidate = s.officialsPool.firstWhere((c) => c.id == chosen);
    final yes = await showDialog<bool>(
      context: context,
      builder:
          (context) => AlertDialog(
            insetPadding: _personnelDialogInsets(context),
            title: Text(
              'Bổ nhiệm ${candidate.name}?',
              style: const TextStyle(fontFamily: 'Lora'),
            ),
            content: SingleChildScrollView(
              child: Text(
                'Tiếp nhận chức ${outgoing.role} (bậc ${appointmentRank(outgoing.role)}/4) thay ${outgoing.name}.\nNăng lực ${candidate.ability} · chuyên môn ${candidate.specialty}. Địa vị: ảnh hưởng ${candidate.influence}/100. Phí dựa trên cả năng lực, địa vị và chức vụ tiếp nhận.\n\nChi ${appointmentCost(candidate, outgoing.role)} tiền · 1 hành động · uy quyền +1 · Ổn định triều đình −${replacementDisruption(outgoing)}.\nPhe ${candidate.faction} +5 thái độ, phe ${factionOpponents[candidate.faction]} −6; thành viên phe đối lập giảm 2 thiện cảm. ${outgoing.faction != candidate.faction ? 'Phe ${outgoing.faction} còn giảm 4 vì người cũ bị bãi chức.' : ''}\n\n${outgoing.influence >= 60 ? 'Phe người cũ còn bất mãn −1/${s.periodName} trong ${s.seasonal ? 1 : 3} ${s.periodName}. ' : ''}Công việc đang giao chuyển sang người mới, giữ tiến độ; thời hạn nhiệm vụ đại biến cố đã cam kết giữ nguyên. Các việc thường tính kết quả theo năng lực/chuyên môn của người mới. Tấu chương đã giao riêng cho người bị bãi chức sẽ gián đoạn, không tự chuyển phân công.${s.stability <= replacementDisruption(outgoing) ? '\n\nCẢNH BÁO: thay người lúc này sẽ khiến Ổn định triều đình về 0 và kết thúc lượt chơi.' : ''}',
                style: const TextStyle(height: 1.8),
              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(context, false),
                child: const Text('Hủy'),
              ),
              FilledButton(
                onPressed: () => Navigator.pop(context, true),
                child: Text(
                  'Bổ nhiệm · ${appointmentCost(candidate, outgoing.role)} tiền',
                ),
              ),
            ],
          ),
    );
    if (yes == true) {
      await act('appoint', target: outgoing.id, option: candidate.id);
    }
  }

  Widget _health() => Column(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      _heading(
        'Long thể & nhịp sống',
        'Làm việc cần sức lực. Hưởng lạc cũng cần chừng mực.',
