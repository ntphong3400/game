const parchment = Color(0xFFF5F2EA);
const paper = Color(0xFFFCFAF5);
const ink = Color(0xFF29382F);
const muted = Color(0xFF788076);
const forest = Color(0xFF3E5947);
const gold = Color(0xFFAA854C);
const line = Color(0xFFE4E3D8);
const terracotta = Color(0xFFA55F49);

class GameApp extends StatelessWidget {
  const GameApp({
    super.key,
    required this.controller,
    this.initialRoute = 'citadel',
  });
  final GameController controller;

  /// Starting section; existing section tests can open their subject directly.
  final String initialRoute;
  @override
  Widget build(BuildContext context) => MaterialApp(
    title: 'Vạn Tuế — Một đời đế vương',
    debugShowCheckedModeBanner: false,
    theme: ThemeData(
      useMaterial3: true,
      fontFamily: 'BeVietnam',
      scaffoldBackgroundColor: parchment,
      colorScheme: ColorScheme.fromSeed(
        seedColor: forest,
        primary: forest,
        surface: paper,
        onSurface: ink,
      ),
      textTheme: const TextTheme(
        bodyMedium: TextStyle(fontSize: 13, height: 1.65, color: ink),
        bodySmall: TextStyle(fontSize: 11, height: 1.65, color: muted),
      ),
      dividerColor: line,
      filledButtonTheme: FilledButtonThemeData(
        style: FilledButton.styleFrom(
          backgroundColor: forest,
          foregroundColor: paper,
          minimumSize: const Size(0, 46),
          padding: const EdgeInsets.symmetric(horizontal: 22, vertical: 15),
          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
        ),
      ),
      outlinedButtonTheme: OutlinedButtonThemeData(
        style: OutlinedButton.styleFrom(
          foregroundColor: forest,
          side: const BorderSide(color: line),
          minimumSize: const Size(0, 44),
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
        ),
      ),
      inputDecorationTheme: InputDecorationTheme(
        filled: true,
        fillColor: paper,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(8),
          borderSide: const BorderSide(color: line),
        ),
        enabledBorder: OutlineInputBorder(
          borderRadius: BorderRadius.circular(8),
          borderSide: const BorderSide(color: line),
        ),
      ),
      snackBarTheme: SnackBarThemeData(
        behavior: SnackBarBehavior.floating,
        backgroundColor: ink,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
      ),
      dialogTheme: DialogTheme(
        backgroundColor: paper,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      ),
    ),
    home: GameShell(controller: controller, initialRoute: initialRoute),
  );
}

class GameShell extends StatefulWidget {
  const GameShell({
    super.key,
    required this.controller,
    this.initialRoute = 'citadel',
  });
  final GameController controller;
  final String initialRoute;
  @override
  State<GameShell> createState() => _GameShellState();
}

class _GameShellState extends State<GameShell> {
  late String route = widget.initialRoute;
  final scaffoldKey = GlobalKey<ScaffoldState>();
  GameController get controller => widget.controller;
  GameState get s => controller.state!;
  bool get busy => controller.busy;
  final scrollController = ScrollController();
  final courtSearch = TextEditingController();
  final haremSearch = TextEditingController();
  String courtCategory = 'Tất cả', haremCategory = 'Tất cả';
  String courtFaction = 'Tất cả', haremFaction = 'Tất cả';
  String scoreRules = rulesVersion;
  String? acknowledgedEnding;
  static const navigation = <(String, IconData, String)>[
    ('citadel', Icons.castle_outlined, 'Hoàng thành'),
    ('court', Icons.account_balance_outlined, 'Triều chính'),
    ('kingdom', Icons.landscape_outlined, 'Quốc sự'),
    ('treasury', Icons.savings_outlined, 'Ngân khố'),
    ('people', Icons.groups_outlined, 'Triều thần'),
    ('harem', Icons.local_florist_outlined, 'Hậu cung'),
    ('health', Icons.favorite_border, 'Long thể'),
    ('journal', Icons.menu_book_outlined, 'Sử ký'),
    ('scores', Icons.emoji_events_outlined, 'Bảng xếp hạng'),
  ];

  @override
  void dispose() {
    scrollController.dispose();
    courtSearch.dispose();
    haremSearch.dispose();
    super.dispose();
  }

  void navigate(String value) {
    setState(() => route = value);
    if (scrollController.hasClients) scrollController.jumpTo(0);
  }

  Future<bool> act(
    String type, {
    String target = '',
    String option = '',
    String assigneeId = '',
  }) async {
    final previousOutcomes = controller.state?.outcomes.length ?? 0;
    final ok = await controller.act(
      type,
      target: target,
      option: option,
      assigneeId: assigneeId,
    );
    if (!mounted) return ok;
    final messenger = ScaffoldMessenger.of(context);
    messenger.hideCurrentSnackBar();
    if (!ok) {
      messenger.showSnackBar(
        SnackBar(
          content: Text(
            s.calendarText(controller.error ?? 'Chưa thực hiện được.'),
          ),
        ),
      );
    } else if (type != 'endWeek' && !s.ended) {
      messenger.showSnackBar(
        SnackBar(
          duration: const Duration(seconds: 2),
          content: Row(
            children: [
              Icon(Icons.check_circle_outline, color: Colors.white, size: 18),
              const SizedBox(width: 10),
              Expanded(child: Text(s.journal.first.title)),
            ],
          ),
        ),
      );
    }
    if (ok && s.outcomes.length > previousOutcomes) {
      await showOutcomeReports(
        context,
        s.outcomes.skip(previousOutcomes).toList(),
        seasonal: s.seasonal,
      );
    }
    return ok;
  }

  Future<void> startDialog() async {
    final name = TextEditingController(
      text: controller.state?.playerName ?? '',
    );
    final form = GlobalKey<FormState>();
    final result = await showDialog<String>(
      context: context,
      builder:
          (context) => AlertDialog(
            title: const Text(
              'Một triều đại mới',
              style: TextStyle(fontFamily: 'Lora'),
            ),
            content: SizedBox(
              width: 380,
              child: Form(
                key: form,
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text(
                      'Mười tám tuổi, bạn nhận ngọc tỷ. Từ hôm nay, vận mệnh giang sơn nằm trong từng quyết định.',
                    ),
                    const SizedBox(height: 22),
                    TextFormField(
                      controller: name,
                      autofocus: true,
                      maxLength: 32,
                      decoration: const InputDecoration(
                        labelText: 'Tên người chơi',
                        hintText: 'Bạn muốn được ghi tên thế nào?',
                      ),
                      validator:
                          (value) =>
                              value == null || value.trim().isEmpty
                                  ? 'Vui lòng nhập tên người chơi.'
                                  : null,
                      onFieldSubmitted: (_) {
                        if (form.currentState!.validate()) {
                          Navigator.pop(context, name.text.trim());
                        }
                      },
                    ),
                    if (controller.state != null && !s.ended)
                      const Text(
                        'Bắt đầu lại sẽ thay lượt đang chơi. Lượt bị bỏ không được ghi thành tích.',
                        style: TextStyle(color: terracotta, fontSize: 12),
                      ),
                  ],
                ),
              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(context),
                child: const Text('Để sau'),
              ),
              FilledButton(
                onPressed: () {
                  if (form.currentState!.validate()) {
                    Navigator.pop(context, name.text.trim());
                  }
                },
                child: const Text('Nhận ngọc tỷ'),
              ),
            ],
          ),
    );
    // A dialog can still be unmounting during its reverse animation.
    Future<void>.delayed(const Duration(milliseconds: 500), name.dispose);
    if (result == null || !mounted) return;
    final ok = await controller.start(result);
    if (!mounted) return;
    if (ok) {
      navigate('citadel');
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(controller.error ?? 'Không thể bắt đầu lượt mới.'),
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) => AnimatedBuilder(
    animation: controller,
    builder: (context, _) {
      if (controller.loading) {
        return const Scaffold(
          body: Center(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Crest(size: 56),
                SizedBox(height: 24),
                CircularProgressIndicator(strokeWidth: 2),
              ],
            ),
          ),
        );
      }
      if (route == 'home' || (controller.state == null && route != 'scores')) {
        return _landing();
      }
      if (controller.state?.ended == true && route != 'scores') {
        return acknowledgedEnding == s.runId ? _ending() : _endingReason();
      }
      if (route == 'citadel') {
        return Scaffold(
          key: scaffoldKey,
          backgroundColor: const Color(0xFF142D28),
          drawer: Drawer(backgroundColor: paper, child: _sidebar()),
          body: CitadelHub(
            state: s,
            busy: busy,
            onNavigate: navigate,
            onMenu: () => scaffoldKey.currentState?.openDrawer(),
            onEndTurn: _nextWeek,
            onOvertime: _overtimeDialog,
          ),
        );
      }
      return LayoutBuilder(
        builder: (context, constraints) {
          final desktop = constraints.maxWidth >= 1050;
          return Scaffold(
            key: scaffoldKey,
            drawer:
                desktop
                    ? null
                    : Drawer(backgroundColor: paper, child: _sidebar()),
            body: Row(
              children: [
                if (desktop) SizedBox(width: 220, child: _sidebar()),
                Expanded(
                  child: Column(
                    children: [
                      _toolbar(desktop),
                      if (busy) const LinearProgressIndicator(minHeight: 2),
                      Expanded(
                        child: SingleChildScrollView(
                          controller: scrollController,
                          padding: EdgeInsets.all(desktop ? 32 : 18),
                          child: Center(
                            child: ConstrainedBox(
                              constraints: const BoxConstraints(maxWidth: 1320),
                              child: _page(),
                            ),
                          ),
                        ),
                      ),
                      if (controller.state != null &&
                          !s.ended &&
                          route != 'scores')
                        _weekbar(desktop),
                    ],
                  ),
                ),
              ],
            ),
          );
        },
      );
    },
  );

  Widget _sidebar() => Container(
    decoration: const BoxDecoration(
      color: paper,
      border: Border(right: BorderSide(color: line)),
    ),
    child: SafeArea(
      child: SingleChildScrollView(
        child: Padding(
          padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 28),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              InkWell(
                onTap: () => navigate('home'),
                borderRadius: BorderRadius.circular(8),
                child: const Padding(
                  padding: EdgeInsets.symmetric(horizontal: 10),
                  child: Row(
                    children: [
                      Crest(size: 38),
                      SizedBox(width: 12),
                      Expanded(
                        child: FittedBox(
                          alignment: Alignment.centerLeft,
                          fit: BoxFit.scaleDown,
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                'VẠN TUẾ',
                                style: TextStyle(
                                  fontFamily: 'Lora',
                                  fontSize: 19,
                                  letterSpacing: 2,
                                ),
                              ),
                              Text(
                                'MỘT ĐỜI ĐẾ VƯƠNG',
                                style: TextStyle(
                                  fontSize: 7,
                                  color: gold,
                                  letterSpacing: 1.6,
                                ),
                              ),
                            ],
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
              const SizedBox(height: 44),
              const Padding(
                padding: EdgeInsets.only(left: 13, bottom: 14),
                child: Text(
                  'CHỐN HOÀNG THÀNH',
                  style: TextStyle(
                    fontSize: 9,
                    color: muted,
                    letterSpacing: 1.6,
                  ),
                ),
              ),
              ...navigation.map((item) {
                final selected = route == item.$1;
                return Padding(
                  padding: const EdgeInsets.only(bottom: 5),
                  child: Material(
                    color: selected ? Color(0xFFEAF0E7) : Colors.transparent,
                    borderRadius: BorderRadius.circular(8),
                    child: InkWell(
                      key: ValueKey('nav-${item.$1}'),
                      borderRadius: BorderRadius.circular(8),
                      onTap: () {
                        if (scaffoldKey.currentState?.isDrawerOpen == true) {
                          Navigator.pop(context);
                        }
                        navigate(item.$1);
                      },
                      child: Padding(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 13,
                          vertical: 14,
                        ),
                        child: Row(
                          children: [
                            Icon(
                              item.$2,
                              size: 20,
                              color: selected ? forest : muted,
                            ),
                            const SizedBox(width: 12),
                            Expanded(
                              child: Text(
                                item.$3,
                                style: TextStyle(
                                  fontSize: 12,
                                  fontWeight:
                                      selected
                                          ? FontWeight.w600
                                          : FontWeight.normal,
                                  color: selected ? forest : muted,
                                ),
                              ),
                            ),
                            if (item.$1 == 'court' &&
                                controller.state != null &&
                                s.petitions.isNotEmpty)
                              Badge.count(
                                count: s.petitions.length,
                                backgroundColor: gold,
                                textColor: paper,
                              ),
                          ],
                        ),
                      ),
                    ),
                  ),
                );
              }),
              const SizedBox(height: 24),
              Container(
                padding: const EdgeInsets.all(14),
                decoration: BoxDecoration(
                  color: parchment,
                  borderRadius: BorderRadius.circular(10),
                ),
                child: const Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Icon(Icons.spa_outlined, color: gold, size: 22),
                    SizedBox(height: 10),
                    Text(
                      'Giữ nước, giữ lòng người.\nVà giữ cả chính mình.',
                      style: TextStyle(
                        fontFamily: 'Lora',
                        fontSize: 12,
                        height: 1.7,
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(height: 18),
              const Row(
                children: [
                  Icon(Icons.check_circle_outline, size: 13, color: forest),
                  SizedBox(width: 6),
                  Expanded(
                    child: Text(
                      'Tự lưu trên thiết bị',
                      style: TextStyle(fontSize: 10, color: muted),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 5),
              Text(
                'BẢN CHƠI THỬ  ·  ${rulesVersion.replaceFirst('mvp-', '')}',
                style: const TextStyle(
                  fontSize: 8,
                  color: muted,
                  letterSpacing: 1.5,
                ),
              ),
            ],
          ),
        ),
      ),
    ),
  );

  Widget _toolbar(bool desktop) => Container(
    height: 78,
    padding: EdgeInsets.symmetric(horizontal: desktop ? 32 : 12),
    decoration: BoxDecoration(border: Border(bottom: BorderSide(color: line))),
    child: Row(
      children: [
        if (desktop)
          IconButton(
            tooltip: 'Về Hoàng thành',
            onPressed: () => navigate('citadel'),
            icon: const Icon(Icons.castle_outlined, color: forest),
          ),
        if (!desktop)
          IconButton(
            tooltip: 'Mở danh mục',
            onPressed: () => scaffoldKey.currentState?.openDrawer(),
            icon: const Icon(Icons.menu),
          ),
        Expanded(
          child: Text(
            desktop
                ? 'HOÀNG THÀNH   /   ${navigation.firstWhere((n) => n.$1 == route).$3.toUpperCase()}'
                : 'VẠN TUẾ',
            style: TextStyle(fontSize: 10, color: muted, letterSpacing: 1.5),
          ),
        ),
        if (controller.state != null) ...[
          if (desktop)
            Text(
              'THIÊN HÒA NĂM ${s.year}',
              style: TextStyle(fontSize: 10, color: gold, letterSpacing: 1.2),
            ),
          const SizedBox(width: 20),
          CircleAvatar(
            radius: 17,
            backgroundColor: const Color(0xFFE9E4D5),
            child: Text(
              s.playerName.characters.first.toUpperCase(),
              style: const TextStyle(color: forest, fontSize: 13),
            ),
          ),
          const SizedBox(width: 9),
          Text(s.playerName, style: const TextStyle(fontSize: 12)),
        ] else
          TextButton(
            onPressed: () => navigate('home'),
            child: const Text('Về trang chính'),
          ),
      ],
    ),
  );

  Widget _page() => switch (route) {
    'scores' => _scores(),
    'kingdom' => _kingdom(),
    'treasury' => _treasury(),
    'people' => _people(false),
    'harem' => _people(true),
    'health' => _health(),
    'journal' => _journal(),
    _ => _dashboard(),
  };

  Widget _heading(String title, String subtitle, {Widget? trailing}) => Padding(
    padding: const EdgeInsets.only(bottom: 26),
    child: Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                title,
                style: TextStyle(fontFamily: 'Lora', fontSize: 30, height: 1.3),
              ),
              const SizedBox(height: 8),
              Text(subtitle, style: TextStyle(color: muted, fontSize: 12)),
            ],
          ),
        ),
        if (trailing != null) trailing,
      ],
    ),
  );

  Widget _reignPanel({bool compact = false}) => ReignPanel(
    state: s,
    busy: busy,
    compact: compact,
    onOpen: () => navigate('kingdom'),
    onPetitions: () => navigate('court'),
    send: (type, target, option) async {
      await act(type, target: target, option: option);
    },
  );

  Widget _dashboard() => Column(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      _heading(
        'Giang sơn trong tay người',
        s.seasonal
            ? '${s.actionsPerTurn} hành động mỗi mùa · 4–6 tấu chương · trình đầy đủ ngay đầu mùa.'
            : 'Một tuần mới, những quyết định mới. Bệ hạ muốn bắt đầu từ đâu?',
        trailing: Tag(
          s.seasonal
              ? 'MÙA ${s.season.toUpperCase()} · NĂM TRỊ VÌ ${s.year} · ${s.age} TUỔI'
              : 'MÙA ${s.season.toUpperCase()}  ·  TUẦN ${(s.completedWeeks % 52) + 1}',
        ),
      ),
      if (!s.seasonal)
        Surface(
          child: Text(
            'Bản lưu này tiếp tục theo tuần. Bắt đầu triều đại mới để dùng lịch Xuân–Hạ–Thu–Đông, 12 hành động mỗi mùa.',
          ),
        ),
      Container(
        width: double.infinity,
        constraints: const BoxConstraints(minHeight: 184),
        clipBehavior: Clip.antiAlias,
        decoration: BoxDecoration(
          color: const Color(0xFFEAEADD),
          borderRadius: BorderRadius.circular(12),
        ),
        child: Stack(
          children: [
            const Positioned(
              right: 0,
              top: -12,
              bottom: -20,
              width: 500,
              child: PalaceArt(),
            ),
            Positioned.fill(
              child: DecoratedBox(
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    colors: [
                      const Color(0xFFEAEADD),
                      const Color(0xFFEAEADD).withValues(alpha: 0),
                    ],
                    stops: const [.2, .85],
                  ),
                ),
              ),
            ),
            Padding(
              padding: const EdgeInsets.all(26),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  const Text(
                    'NGỌC TỶ ĐÃ TRAO. TRIỀU ĐẠI BẮT ĐẦU.',
                    style: TextStyle(
                      fontSize: 8,
                      color: forest,
                      letterSpacing: 1.9,
                    ),
                  ),
                  const SizedBox(height: 12),
                  Text(
                    'Năm thứ ${s.year} trên ngai vàng',
                    style: const TextStyle(fontFamily: 'Lora', fontSize: 25),
                  ),
                  const SizedBox(height: 9),
                  Text(
                    '${s.age} tuổi  ·  Đã trị vì ${s.duration}',
                    style: const TextStyle(color: forest, fontSize: 11),
                  ),
                  const SizedBox(height: 10),
                  Text(
                    s.war > 0
                        ? 'Biên cương có biến. Cần giữ vững lòng dân và quân sĩ.'
                        : 'Một giang sơn yên ổn được giữ bằng những lựa chọn nhỏ.',
                    style: const TextStyle(color: muted, fontSize: 10),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
      const SizedBox(height: 22),
      _metrics(),
      const SizedBox(height: 18),
      _reignPanel(compact: route != 'kingdom'),
      if (s.outcomes.isNotEmpty) _outcomeSummary(),
      Align(
        alignment: Alignment.centerRight,
        child: TextButton.icon(
          key: const ValueKey('open-finance'),
          onPressed: () => navigate('treasury'),
          icon: const Icon(Icons.receipt_long_outlined, size: 16),
          label: const Text('Xem thu/chi ngân khố'),
